body {
    background: #f4f8fb;
    margin: 0;
    font-family: Arial, sans-serif;
}

/* NAVBAR */
.navbar {
    display: flex;
    justify-content: center;
    gap: 25px;
    padding: 15px;
    background: white;
    box-shadow: 0 4px 14px rgba(0, 150, 255, 0.08);
}

.nav-item {
    text-align: center;
    cursor: pointer;
    transition: 0.2s;
}

.nav-item img {
    width: 28px;
    opacity: 0.7;
}

.nav-item p {
    margin: 5px 0 0;
    font-size: 12px;
}

.nav-item:hover img {
    opacity: 1;
    transform: scale(1.1);
}

/* TOP CATEGORIES */
.top-categories {
    display: flex;
    gap: 15px;
    overflow-x: auto;
    padding: 15px;
}

.circle-item {
    text-align: center;
}

.circle-item img {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 4px 12px rgba(0,150,255,0.15);
}

.circle-item p {
    font-size: 12px;
    margin-top: 6px;
}
.hero-section {
    padding: 20px;
}

.hero-cards {
    display: flex;
    gap: 15px;
    overflow-x: auto;
}

.hero-card {
    min-width: 220px;
    background: linear-gradient(135deg, #00c6ff, #0072ff);
    color: white;
    padding: 18px;
    border-radius: 18px;
    box-shadow: 0 8px 25px rgba(0,150,255,0.2);
    transition: 0.3s;
}

.hero-card:hover {
    transform: translateY(-5px);
}

.hero-card .tag {
    font-size: 12px;
    opacity: 0.8;
}

.hero-card h3 {
    margin: 8px 0;
}

.hero-card span {
    font-size: 13px;
    opacity: 0.9;
}
/* SEARCH */
.search-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin: 25px 0;
}

.search-bar input {
    width: 70%;
    max-width: 500px;
    padding: 13px 16px;
    border: none;
    border-radius: 30px;
    font-size: 14px;
    outline: none;
    background: white;
    box-shadow: 0 4px 14px rgba(0,150,255,0.1);
}

.search-bar input:focus {
    box-shadow: 0 6px 20px rgba(0,150,255,0.2);
}

.search-bar button {
    padding: 12px 18px;
    border: none;
    border-radius: 30px;
    background: linear-gradient(135deg, #00c6ff, #0072ff);
    color: white;
    cursor: pointer;
    transition: 0.3s;
}

.search-bar button:hover {
    transform: scale(1.05);
}
.search-bar button.error {
    background: #ff4d4d;
    animation: shake 0.4s;
}

/* אנימציית רעידה */
@keyframes shake {
    0% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    50% { transform: translateX(5px); }
    75% { transform: translateX(-5px); }
    100% { transform: translateX(0); }
}
.search-suggestions {
    width: 70%;
    max-width: 500px;
    margin: -10px auto 20px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0,150,255,0.1);

    /* ⭐ שדרוג חשוב */
    max-height: 250px;
    overflow-y: auto;
}

/* scrollbar יפה יותר (אופציונלי אבל מומלץ) */
.search-suggestions::-webkit-scrollbar {
    width: 6px;
}

.search-suggestions::-webkit-scrollbar-thumb {
    background: #cce6ff;
    border-radius: 10px;
}

.suggestion-item {
    padding: 10px 15px;
    cursor: pointer;
    transition: 0.2s;
    border-bottom: 1px solid #f3f3f3;
}

.suggestion-item:hover {
    background: #f0f8ff;
}

/* SECTION */
