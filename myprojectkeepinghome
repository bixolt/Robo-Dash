<script>
document.addEventListener("DOMContentLoaded", () => {

    // ===== SLIDER =====
    const sliders = document.querySelectorAll(".slider");

    sliders.forEach(slider => {
        const track = slider.querySelector(".track");

        let isDown = false;
        let startX = 0;
        let scrollLeft = 0;
        let timeout;

        function stopAuto() {
            if (track) track.style.animationPlayState = "paused";
            clearTimeout(timeout);
        }

        function startAuto() {
            timeout = setTimeout(() => {
                if (track) track.style.animationPlayState = "running";
            }, 2000);
        }

        // DESKTOP
        slider.addEventListener("mousedown", (e) => {
            isDown = true;
            startX = e.pageX;
            scrollLeft = slider.scrollLeft;
            stopAuto();
        });

        slider.addEventListener("mouseup", () => {
            isDown = false;
            startAuto();
        });

        slider.addEventListener("mouseleave", () => {
            isDown = false;
            startAuto();
        });

        slider.addEventListener("mousemove", (e) => {
            if (!isDown) return;

            e.preventDefault();
            const walk = (e.pageX - startX) * 1.5;
            slider.scrollLeft = scrollLeft - walk;
        });

        // MOBILE
        slider.addEventListener("touchstart", (e) => {
            isDown = true;
            startX = e.touches[0].pageX;
            scrollLeft = slider.scrollLeft;
            stopAuto();
        });

        slider.addEventListener("touchend", () => {
            isDown = false;
            startAuto();
        });

        slider.addEventListener("touchmove", (e) => {
            if (!isDown) return;

            const walk = (e.touches[0].pageX - startX) * 1.5;
            slider.scrollLeft = scrollLeft - walk;
        });
    });

    // ===== SEARCH =====
    const searchInput = document.querySelector(".search-bar input");
    const searchBtn = document.querySelector(".search-bar button");
    const sections = document.querySelectorAll(
        ".section[id]:not(#favorite):not(.hero-section)"
    );
    const suggestionsBox = document.querySelector(".search-suggestions");

    if (!searchInput || !suggestionsBox) return;

    function runSearch(value) {
        const searchValue = value.toLowerCase().trim();
        suggestionsBox.innerHTML = "";

        sections.forEach(section => {
            const titleEl = section.querySelector("h2");
            if (!titleEl) return;

            const title = titleEl.innerText.toLowerCase();

            if (title.includes(searchValue) ||searchValue==="") {
                section.style.display = "block";

                const div = document.createElement("div");
                div.className = "suggestion-item";
                div.innerText = titleEl.innerText;

                div.addEventListener("click", () => {
                    searchInput.value = titleEl.innerText;
                    runSearch(titleEl.innerText);
                    suggestionsBox.innerHTML = "";

                    
                });

                suggestionsBox.appendChild(div);

            } else {
                section.style.display = "none";
            }
        });
    }

    // typing
    searchInput.addEventListener("input", function () {
        runSearch(this.value);
    });

    // focus (השדרוג שלך)
    searchInput.addEventListener("focus", function () {
        runSearch(this.value);
    });
    searchInput.addEventListener("blur", function (e) {
    // אם עברנו לכפתור → לא סוגרים
    if (e.relatedTarget === searchBtn) return;

    setTimeout(() => {
        suggestionsBox.innerHTML = "";
    }, 150);
});

    // button redirect
if (searchBtn) {
    searchBtn.addEventListener("click", () => {
        const value = searchInput.value.toLowerCase().trim();
        if (!value) return;

        let found = false;

        sections.forEach(section => {
            const titleEl = section.querySelector("h2");
            if (!titleEl) return;

            const title = titleEl.innerText.toLowerCase();

            if (title===value) {
                found = true;
            }
        });

        // אם מצאנו → מעבר דף
        if (found) {
            window.location.href = `Search.html?query=${encodeURIComponent(value)}`;
        } else {
            // ❌ לא נמצא → אפקט שגיאה
            searchBtn.classList.add("error");

            setTimeout(() => {
                searchBtn.classList.remove("error");
            }, 500);
        }
    });
}

});

const searchInput = document.querySelector(".search-bar input");
const scrollBtn = document.getElementById("scrollTopBtn");
let scrollTimeout;

// בזמן גלילה
window.addEventListener("scroll", () => {
    // מסתיר מיד בזמן גלילה
    scrollBtn.classList.remove("show");
    
   const searchPosition = searchInput.offsetTop;
    // מנקה טיימר קודם
    clearTimeout(scrollTimeout);

    // אחרי שהמשתמש מפסיק לגלול → מחזיר
    scrollTimeout = setTimeout(() => {
        if (window.scrollY > searchPosition) {
            scrollBtn.classList.add("show");
        }
    }, 100); // 200ms אחרי עצירה
});

// לחיצה → למעלה

scrollBtn.addEventListener("click", () => {
    searchInput.scrollIntoView({
        behavior: "smooth",
        block: "center"
    });
});
</script>