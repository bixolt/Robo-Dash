function handleSearchChange(value) {
    const v = value.toLowerCase().trim();
    const isEmpty = v === "";

    if (isEmpty) {
        floatingBtn.classList.remove("show");
        SearchButtom = false;
        DeleteSubDropdown();
        clearBtn.style.display = "none";
        dropdown.classList.add("open");
    }

    updateClearButton();

    items.forEach(item => {
        const text = item.textContent.toLowerCase().trim();
        item.style.display = text.includes(v) ? "block" : "none";
    });

    const match = Array.from(items).find(item =>
        item.textContent.toLowerCase().trim() === v
    );

    if (!match) {
        dropdown.classList.remove("shrink");
        dropdown.style.width = "";

        const hasResults = Array.from(items).some(item =>
            item.style.display === "block"
        );

        if (!hasResults && !isEmpty) {
            dropdown.classList.remove("open");
        }

        return;
    }
    searchInput.value = v.charAt(0).toUpperCase() + v.slice(1);
    dropdown.style.setProperty(
        "--shrink-width",
        `${shrinkWidths[v] ?? 40}%`
    );

    dropdown.classList.add("shrink");
    sub.style.display = "block";
    buildSubDropdown(match.textContent);
    activateCategory(match.textContent);
}
