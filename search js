    searchInput.value = v.charAt(0).toUpperCase() + v.slice(1);
    dropdown.style.setProperty(
        "--shrink-width",
        `${shrinkWidths[v] ?? 40}%`
    );

    dropdown.classList.add("shrink");
    sub.style.display = "block";
    buildSubDropdown(match.textContent);
    activateCategory(match.textContent);
