/* =========================================
ADVANCED FLUID SURFACE
========================================= */
const WAVE_STEP = 80;

const wavePoints = [];

for(
    let i = 0;
    i < WAVE_COUNT;
    i++
){
    wavePoints[i] = [];
}

/* =========================================
BUILD WAVE PATH
========================================= */
function buildWavePath(
    time,
    amplitudeMultiplier,
    index
    
    
){

    

    const width =
        WAVE_WIDTH;

    const height =
        280;

    const points =
        wavePoints[index];

    const centerY =

        200 +

        Math.sin(
            time * 0.15
        ) * 10 +

        Math.cos(
            time * 0.07
        ) * 5;

    const breathing =

        Math.sin(
            time * 0.28
        ) *

        12 *

        amplitudeMultiplier;

    let pointIndex = 0;

    for(
        let x = 0;
        x <= width;
        x += WAVE_STEP
    ){

        let point =
            points[pointIndex];

        if(!point){

            point =

                points[pointIndex] = {

                    x: 0,
                    y: 0

                };
        }

        point.x =
            x;

        point.y =


    centerY +

    Math.sin(
        x * 0.0014 +
        time * 0.55
    ) *

    60 *

    amplitudeMultiplier +

    Math.cos(
        x * 0.0028 -
        time * 0.90
    ) *

    35 *

    amplitudeMultiplier +

    Math.sin(
        x * 0.0055 +
        time * 1.60
    ) *

    20 *

    amplitudeMultiplier +

    Math.sin(
        x * 0.016 +
        time * 3.2
    ) *

    4 *

    amplitudeMultiplier +

    breathing;
    pointIndex++;
    }

    let d =
        "M 0 " +
        height;

    d +=
        " L " +
        points[0].x +
        " " +
        points[0].y;

    for(
        let i = 0;
        i < pointIndex - 1;
        i++
    ){

        const current =
            points[i];

        const next =
            points[i + 1];

        d +=

            " Q " +

            current.x +

            " " +

            current.y +

            " " +

            (
                (current.x + next.x) *
                0.5
            ) +

            " " +

            (
                (current.y + next.y) *
                0.5
            );
    }

    const last =
        points[
            pointIndex - 1
        ];

    d +=

        " L " +

        last.x +

        " " +

        last.y +

        " L " +

        width +

        " " +

        height +

        " L 0 " +

        height +

        " Z";

    return d;
}

/* =========================================
ANIMATION
========================================= */
let frameCounter = 0;

function animateWaves(){

    noiseOffset += 0.055;
    
    if (noiseOffset > 60) {
        noiseOffset = 0;
    }

    frameCounter++;

    const updatePath =
        (frameCounter & 1) === 0;

    const updateGradient =
        (frameCounter & 3) === 0;

    for(
        let i = 0;
        i < WAVE_COUNT;
        i++
    ){
        const wave =
            waves[i];
            
    if (!wave) continue;
        const time =
            noiseOffset +
            wave.phase;

        wave.svg.style.transform =

            "translate3d(0,calc(-50% + " +

            (

                Math.sin(
                    time * 0.35
                ) *

                8 +

                Math.cos(
                    time * 0.18
                ) *

                4

            ) +

            "px),0) scaleX(" +

            (

                1 +

                Math.cos(
                    time * 0.08
                ) *

                0.015

            ) +

            ") scaleY(" +

            (

                1 +

                Math.sin(
                    time * 0.14
                ) *

                0.045

            ) +

            ")";

        if(updatePath){

            wave.path.setAttribute(
                "d",
                buildWavePath(
                    time,
                    wave.amplitudeMultiplier,
                    i
                )
            );
        }

        if(updateGradient){

            const shift =

                (
                    Math.sin(
                        time * 0.22
                    ) +
                    1
                ) *
                400;

            wave.gradient.setAttribute(
                "x1",
                -shift
            );

            wave.gradient.setAttribute(
                "x2",
                WAVE_WIDTH -
                shift
            );
        }
    }

    animationId =
        requestAnimationFrame(
            animateWaves
        );
}

/* =========================================
CLEAR
========================================= */
function clearWaves(){

cancelAnimationFrame(  
    animationId  
);  
animationId = null;
waves =  
    new Array(WAVE_COUNT);  

barInner.innerHTML = "";

}

