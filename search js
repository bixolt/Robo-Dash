// ELEMENTS
// ============
const dropdown = document.querySelector(".dropdown");
const textarea = document.querySelector(".describe-box textarea");
const header = document.querySelector(".dropdown-header");
const clearBtn = document.querySelector(".clear-btn");
const items = document.querySelectorAll("#dropdownList .dropdown-item");
const searchInput = document.querySelector(".dropdown-search");
const sub = document.getElementById("subDropdown");
const scrollBtn = document.getElementById("scrollTopBtn");
const floatingBtn = document.getElementById("floatingSearchBtn");

const MIN_HEIGHT = 34;
const MAX_HEIGHT = 220;

// =================
// TEXTAREA AUTO-RESIZE
// =================
textarea.addEventListener("input", () => {
    textarea.style.height = `${MIN_HEIGHT}px`;

    const newHeight = Math.min(textarea.scrollHeight, MAX_HEIGHT);
    textarea.style.height = `${newHeight}px`;

    textarea.style.overflowY = textarea.scrollHeight > MAX_HEIGHT ? "auto" : "hidden";

    if (textarea.value === "") {
        floatingBtn.classList.remove("show");
    } else {
        floatingBtn.classList.add("show");
    }
});

// =================
// פתיחה בפוקוס
// =================
searchInput.addEventListener("focus", () => {
    updateClearButton();
    clearBtnOn();
    dropdown.classList.add("open");
});

// =================
// בחירה
// =================
const shrinkWidths = {
    phones: 42,
    cars: 38,
    furniture: 44,
    gaming: 41,
    clothing: 44,
    books: 40,
    sports: 40,
    toys: 37,
    music: 39,
    appliances: 48,
    jewelry: 41,
    beauty: 41,
    shoes: 39,
    bags: 37,
    watches: 43,
    garden: 41,
    pets: 38,
    tools: 37,
    art: 34,
    office: 39
};

function handleSearchChange(value) {
    const v = value.toLowerCase().trim();
    const isEmpty = v === "";

    if (isEmpty) {
        DeleteSubDropdown();
        if (textarea.value.trim() === "") {
            floatingBtn.classList.remove("show");
        }
        clearBtn.style.display = "none";
        dropdown.classList.add("open");
    }

    updateClearButton();

    items.forEach(item => {
        const text = item.textContent.toLowerCase().trim();
        item.style.display = text.includes(v) ? "block" : "none";
    });

    const match = Array.from(items).find(
        item => item.textContent.toLowerCase().trim() === v
    );

    if (!match) {
        dropdown.classList.remove("shrink");
        dropdown.style.width = "";

        const hasResults = Array.from(items).some(item => item.style.display === "block");

        if (!hasResults && !isEmpty) {
            dropdown.classList.remove("open");
        }

        return;
    }

    searchInput.value = v.charAt(0).toUpperCase() + v.slice(1);
    dropdown.style.setProperty("--shrink-width", `${shrinkWidths[v] ?? 40}%`);
    dropdown.classList.add("shrink");
    sub.style.display = "block";

    buildSubDropdown(match.textContent);
    activateCategory(match.textContent);
}

searchInput.addEventListener("input", (e) => {
    handleSearchChange(e.target.value);
});

items.forEach(item => {
    item.addEventListener("click", () => {
        handleSearchChange(item.textContent);
        clearBtnOff();
        dropdown.classList.remove("open");
    });
});

// =================
// לחיצה מחוץ
// =================
document.addEventListener("click", (e) => {
    if (!dropdown.contains(e.target)) {
        clearBtnOff();
        dropdown.classList.remove("open");
    }
});

function clearBtnOn() {
    clearBtn.style.background = "#000000";
    clearBtn.style.color = "#ffffff";
}

