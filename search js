        const isLong = items.length > MAX_VISIBLE;

        const searchWidth =
            group.length < 8  ? "40%" :
            group.length < 12 ? "45%" :
            group.length < 15 ? "50%" :
            group.length < 20 ? "55%" :
            group.length < 25 ? "70%" :
            group.length < 30 ? "80%" :
            group.length < 35 ? "85%" :
            "100%";

        // ==================================================
        // BUILD NORMAL ITEMS
        // ==================================================
        const itemsHTML = items.map((item, i) => {
            const value = typeof item === "string" ? item : item.value;
