    }).join("");

    // ==================================================
    // INSERT HTML
    // ==================================================
    sub.innerHTML = html;

    // ==================================================
    // INITIALIZE RANGE / SLIDER / OTHER SUB LOGIC
    // ==================================================
    setupSub();
}

// =================
// FILTER BEHAVIOR
// =================
function setupSub() {

    document.querySelectorAll(".filter-group").forEach(group => {

        // ==================================================
        // STANDARD / RECTANGULAR RANGE
        // ==================================================
        const minSlider = group.querySelector(".standard-range-min, .rectangular-range-min");
        const maxSlider = group.querySelector(".standard-range-max, .rectangular-range-max");
        const minInput = group.querySelector(".standard-range-min-input, .rectangular-range-min-input");
        const maxInput = group.querySelector(".standard-range-max-input, .rectangular-range-max-input");
        const range = group.querySelector(".standard-range-axis, .rectangular-range-axis");

        // אין RANGE בקבוצה הזאת
        if (!minSlider || !maxSlider || !minInput || !maxInput) {
            return;
        }

        // ==================================================
        // ABSOLUTE MIN / MAX / STEP
        // ==================================================
        const ABS_MIN = parseFloat(minSlider.min) || 0;
        const ABS_MAX = parseFloat(maxSlider.max) || 10000;
        const STEP = parseFloat(minSlider.step) || 1;

        // ==================================================
        // SNAP VALUE TO STEP (RELATIVE TO ABS_MIN)
        // ==================================================
        const snapToStep = (val) => {
            const steps = Math.round((val - ABS_MIN) / STEP);
            let snapped = ABS_MIN + steps * STEP;

            if (snapped < ABS_MIN) snapped = ABS_MIN;
            if (snapped > ABS_MAX) snapped = ABS_MAX;

            // round floating point noise (e.g. 0.1 + 0.2)
            const decimals = (STEP.toString().split(".")[1] || "").length;
            return decimals > 0 ? parseFloat(snapped.toFixed(decimals)) : Math.round(snapped);
        };

        // ==================================================
        // UPDATE RANGE BAR
        // ==================================================
        const updateBars = () => {
            const min = parseFloat(minSlider.value) || ABS_MIN;
            const max = parseFloat(maxSlider.value) || ABS_MAX;
            const total = ABS_MAX - ABS_MIN;

            let minPercent = 0;
            let maxPercent = 100;

            if (total > 0) {
                minPercent = ((min - ABS_MIN) / total) * 100;
                maxPercent = ((max - ABS_MIN) / total) * 100;
            }

            if (range) {
                range.style.setProperty("--min", minPercent + "%");
                range.style.setProperty("--max", maxPercent + "%");
            }
        };

        // ==================================================
        // UPDATE ALL VALUES
        // ==================================================
        const update = () => {
            let min = parseFloat(minSlider.value);
            let max = parseFloat(maxSlider.value);

            // FALLBACK
            if (isNaN(min)) min = ABS_MIN;
            if (isNaN(max)) max = ABS_MAX;

            // SNAP TO STEP
            min = snapToStep(min);
            max = snapToStep(max);

            // LIMITS
            if (min < ABS_MIN) min = ABS_MIN;
            if (min > ABS_MAX) min = ABS_MAX;
            if (max < ABS_MIN) max = ABS_MIN;
            if (max > ABS_MAX) max = ABS_MAX;

            // MIN / MAX RELATION
            if (min > max) min = max;
            if (max < min) max = min;

            // UPDATE SLIDERS
            minSlider.value = min;
            maxSlider.value = max;

            // UPDATE INPUTS
            minInput.value = min;
            maxInput.value = max;

            // UPDATE VISUAL RANGE
            updateBars();
        };

        // ==================================================
        // MIN INPUT
        // ==================================================
        const applyMinInput = () => {
            let val = parseFloat(minInput.value);

            if (isNaN(val)) val = ABS_MIN;
            val = snapToStep(val);

            if (val < ABS_MIN) val = ABS_MIN;
            if (val > ABS_MAX) val = ABS_MAX;

            const currentMax = parseFloat(maxSlider.value);
            if (!isNaN(currentMax) && val > currentMax) val = currentMax;

            minSlider.value = val;
            update();
        };

        // ==================================================
        // MAX INPUT
        // ==================================================
        const applyMaxInput = () => {
            let val = parseFloat(maxInput.value);

            if (isNaN(val)) val = ABS_MAX;
            val = snapToStep(val);

            if (val < ABS_MIN) val = ABS_MIN;
            if (val > ABS_MAX) val = ABS_MAX;

            const currentMin = parseFloat(minSlider.value);
            if (!isNaN(currentMin) && val < currentMin) val = currentMin;

            maxSlider.value = val;
            update();
        };

        // ==================================================
        // SLIDERS
        // ==================================================
        minSlider.addEventListener("input", update);
        maxSlider.addEventListener("input", update);

        // ==================================================
        // MIN INPUT
        // ==================================================
        minInput.addEventListener("keydown", event => {
            if (event.key === "Enter") {
                applyMinInput();
                minInput.blur();
            }
        });

        // ==================================================
        // MAX INPUT
        // ==================================================
        maxInput.addEventListener("keydown", event => {
            if (event.key === "Enter") {
                applyMaxInput();
                maxInput.blur();
            }
        });

        // ==================================================
        // BLUR
        // ==================================================
        minInput.addEventListener("blur", applyMinInput);
        maxInput.addEventListener("blur", applyMaxInput);

        // ==================================================
        // INITIALIZE
        // ==================================================
        update();
    });

    // =================
    // STANDARD RANGE ELEMENTS
    // =================
    const barInner = document.querySelector(".bar-inner");
    const standardSliders = document.querySelectorAll(".standard-range-slider");
    const rectangularSliders = document.querySelectorAll(".rectangular-range-slider");

    /* =========================================
       CLEAR WAVES
    ========================================= */
    const WAVE_WIDTH = 2400;
    const WAVE_COUNT = 2;

    let waves = new Array(WAVE_COUNT);
    let noiseOffset = 0;
    let animationId = null;

    const colors = [
        "rgba(25,25,25,1)",
        "rgba(25,25,25,1)",
        "rgba(25,25,25,1)",
        "rgba(25,25,25,1)",
        "rgba(25,25,25,1)",
        "rgba(25,25,25,1)"
    ];

    /* =========================================
       CREATE FLOW
    ========================================= */
    function createWaveFlow() {
        cancelAnimationFrame(animationId);

        barInner.innerHTML = "";
        waves = new Array(WAVE_COUNT);
        noiseOffset = 0;

        createWaveLayer(0.0, 1.00, 0.75, 0);
        createWaveLayer(1.4, 0.90, 0.65, 1);

        animateWaves();
    }

    /* =========================================
       CREATE LAYER
    ========================================= */
    function createWaveLayer(phase, amplitudeMultiplier, opacity, index) {
        const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        svg.style.willChange = "transform";
        svg.setAttribute("viewBox", `0 0 ${WAVE_WIDTH} 320`);
        svg.setAttribute("preserveAspectRatio", "none");
        svg.style.position = "absolute";
        svg.style.left = "0";
        svg.style.top = "70%";
        svg.style.width = "110%";
        svg.style.height = "180%";
        svg.style.pointerEvents = "none";
        svg.style.opacity = opacity;
        svg.style.mixBlendMode = navigator.hardwareConcurrency <= 4 ? "normal" : "screen";

        const defs = document.createElementNS("http://www.w3.org/2000/svg", "defs");
        const gradient = document.createElementNS("http://www.w3.org/2000/svg", "linearGradient");
        const gradientId = `waveGradient_${index}`;

        gradient.setAttribute("id", gradientId);
        gradient.setAttribute("gradientUnits", "userSpaceOnUse");
        gradient.setAttribute("x1", "0");
        gradient.setAttribute("x2", WAVE_WIDTH);
        gradient.setAttribute("y1", "0");
        gradient.setAttribute("y2", "0");

        for (let i = 0; i < colors.length; i++) {
            const stop = document.createElementNS("http://www.w3.org/2000/svg", "stop");
            stop.setAttribute("offset", `${(i / (colors.length - 1)) * 100}%`);
            stop.setAttribute("stop-color", colors[i]);
            gradient.appendChild(stop);
        }

        defs.appendChild(gradient);

        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("fill", `url(#${gradientId})`);

        svg.appendChild(defs);
        svg.appendChild(path);
        barInner.appendChild(svg);

        waves[index] = { svg, path, gradient, phase, amplitudeMultiplier };
    }

    /* =========================================
       ADVANCED FLUID SURFACE
    ========================================= */
    const WAVE_STEP = 80;
    const wavePoints = [];

    for (let i = 0; i < WAVE_COUNT; i++) {
        wavePoints[i] = [];
    }

    /* =========================================
       BUILD WAVE PATH
    ========================================= */
    function buildWavePath(time, amplitudeMultiplier, index) {
        const width = WAVE_WIDTH;
        const height = 280;
        const points = wavePoints[index];

        const centerY =
            200 +
            Math.sin(time * 0.15) * 10 +
            Math.cos(time * 0.07) * 5;

        const breathing = Math.sin(time * 0.28) * 12 * amplitudeMultiplier;

        let pointIndex = 0;

        for (let x = 0; x <= width; x += WAVE_STEP) {
            let point = points[pointIndex];

            if (!point) {
                point = points[pointIndex] = { x: 0, y: 0 };
            }

            point.x = x;

            point.y =
                centerY +
                Math.sin(x * 0.0014 + time * 0.55) * 60 * amplitudeMultiplier +
                Math.cos(x * 0.0028 - time * 0.90) * 35 * amplitudeMultiplier +
                Math.sin(x * 0.0055 + time * 1.60) * 20 * amplitudeMultiplier +
                Math.sin(x * 0.016 + time * 3.2) * 4 * amplitudeMultiplier +
                breathing;

            pointIndex++;
        }

        let d = "M 0 " + height;
        d += " L " + points[0].x + " " + points[0].y;

        for (let i = 0; i < pointIndex - 1; i++) {
            const current = points[i];
            const next = points[i + 1];

            d +=
                " Q " + current.x + " " + current.y +
                " " + ((current.x + next.x) * 0.5) +
                " " + ((current.y + next.y) * 0.5);
        }

        const last = points[pointIndex - 1];

        d +=
            " L " + last.x + " " + last.y +
            " L " + width + " " + height +
            " L 0 " + height +
            " Z";

        return d;
    }

    /* =========================================
       ANIMATION
    ========================================= */
    let frameCounter = 0;

    function animateWaves() {
        noiseOffset += 0.055;

        if (noiseOffset > 60) {
            noiseOffset = 0;
        }

        frameCounter++;

        const updatePath = (frameCounter & 1) === 0;
        const updateGradient = (frameCounter & 3) === 0;

        for (let i = 0; i < WAVE_COUNT; i++) {
            const wave = waves[i];
            if (!wave) continue;

            const time = noiseOffset + wave.phase;

            wave.svg.style.transform =
                "translate3d(0,calc(-50% + " +
                (Math.sin(time * 0.35) * 8 + Math.cos(time * 0.18) * 4) +
                "px),0) scaleX(" +
                (1 + Math.cos(time * 0.08) * 0.015) +
                ") scaleY(" +
                (1 + Math.sin(time * 0.14) * 0.045) +
                ")";

            if (updatePath) {
                wave.path.setAttribute("d", buildWavePath(time, wave.amplitudeMultiplier, i));
            }

            if (updateGradient) {
                const shift = (Math.sin(time * 0.22) + 1) * 400;
                wave.gradient.setAttribute("x1", -shift);
                wave.gradient.setAttribute("x2", WAVE_WIDTH - shift);
            }
        }

        animationId = requestAnimationFrame(animateWaves);
    }

    /* =========================================
       CLEAR
    ========================================= */
    function clearWaves() {
        cancelAnimationFrame(animationId);
        animationId = null;
        waves = new Array(WAVE_COUNT);
        barInner.innerHTML = "";
    }

    /* =========================================
       START
    ========================================= */
    document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
            cancelAnimationFrame(animationId);
        } else if (!animationId) {
            animateWaves();
        }
    });

    createWaveFlow();

    function setWaveColor(color) {
        document.querySelectorAll('#waveGradient_0 stop, #waveGradient_1 stop').forEach(stop => {
            stop.setAttribute("stop-color", color);
        });
    }

    function setSliderActiveStyle() {
        setWaveColor("rgba(20,20,20,1)");
        document.documentElement.style.setProperty("--slider-thumb-bg", "#000000");
        document.documentElement.style.setProperty("--slider-thumb-border", "1px solid rgba(255,120,120,0.45)");
        document.documentElement.style.setProperty("--before-range-line-bg", "#000000");
        document.documentElement.style.setProperty("--before-range-line-border", "1px solid rgba(200,70,70,0.22)");
        document.documentElement.style.setProperty("--after-range-line-bg", "#000000");
        document.documentElement.style.setProperty("--after-range-line-border", "1px solid rgba(200,70,70,0.22)");
    }

    function setSliderIdleStyle() {
        setWaveColor("rgba(25,25,25,1)");
        document.documentElement.style.setProperty("--slider-thumb-bg", "#121212");
        document.documentElement.style.setProperty("--slider-thumb-border", "1px solid rgba(90,90,90,.85)");
        document.documentElement.style.setProperty("--before-range-line-bg", "#121212");
        document.documentElement.style.setProperty("--before-range-line-border", "1px solid rgba(90,90,90,.75)");
        document.documentElement.style.setProperty("--after-range-line-bg", "#121212");
        document.documentElement.style.setProperty("--after-range-line-border", "1px solid rgba(90,90,90,.85)");
    }

    standardSliders.forEach(slider => {
        slider.addEventListener("pointerdown", setSliderActiveStyle);
        slider.addEventListener("pointerup", setSliderIdleStyle);
    });

    rectangularSliders.forEach(slider => {
        slider.addEventListener("pointerdown", setSliderActiveStyle);
        slider.addEventListener("pointerup", setSliderIdleStyle);
        slider.addEventListener("pointercancel", setSliderIdleStyle);
    });

    // ================= GROUPS (DELEGATED) =================
    function debounce(fn, delay = 150) {
        let timer;
        return (...args) => {
            clearTimeout(timer);
            timer = setTimeout(() => {
                fn(...args);
            }, delay);
        };
    }

    function normalize(str) {
        return (str || "").trim().toLowerCase();
    }

    sub.addEventListener("click", (e) => {
        const btn = e.target.closest(".show-more");

        if (btn) {
            const group = btn.closest(".filter-group");
            if (!group) return;

            const groupItems = group.querySelectorAll(".sub-item");
            const expanded = btn.dataset.expanded === "true";

            groupItems.forEach((item, i) => {
                item.style.display = expanded ? (i < 8 ? "block" : "none") : "block";
            });

            btn.textContent = expanded ? `More ${group.dataset.category || ""}` : "Show less";
            btn.dataset.expanded = (!expanded).toString();

            return;
        }

        const item = e.target.closest(".sub-item");
        if (item) {
            item.classList.toggle("selected");
        }
    });

    sub.addEventListener("input", debounce((e) => {
        const search = e.target.closest(".sub-search");
        if (!search) return;

        const group = search.closest(".filter-group");
        if (!group) return;

        const groupItems = group.querySelectorAll(".sub-item");
        const query = normalize(search.value);

        groupItems.forEach(item => {
            const value = normalize(item.dataset.value);
            const synonymsList = (item.dataset.synonyms || "")
                .split(",")
                .map(normalize)
                .filter(Boolean);

            const matches =
                query === "" ||
                value.includes(query) ||
                synonymsList.some(synonym => synonym.includes(query));

            item.style.display = matches ? "block" : "none";
        });
    }, 120));

    const currencyHeader = document.querySelector(".currency-header");
    const currencyBox = document.querySelector(".currency-box");

    if (currencyHeader && currencyBox) {
        currencyHeader.onclick = () => {
            currencyBox.classList.toggle("open");
        };

        const currencyItems = document.querySelectorAll(".currency-item");
        const currencySearch = document.querySelector(".currency-search");

        document.addEventListener("click", (e) => {
            if (!currencyBox.contains(e.target)) {
                currencyBox.classList.remove("open");
            }
        });

        currencyItems.forEach(item => {
            item.onclick = () => {
                currencyHeader.textContent = item.textContent + " ▼";
                currencyBox.classList.remove("open");
            };
        });

        if (currencySearch) {
            currencySearch.oninput = () => {
                const val = currencySearch.value.toLowerCase();

                currencyItems.forEach(item => {
                    item.style.display = item.textContent.toLowerCase().includes(val) ? "block" : "none";
                });
            };
        }
    }
}

// =================
// NAVBAR SCROLL STATE
// =================
const navbar = document.querySelector(".top-navbar");

window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
        navbar.classList.add("scrolled");
    } else {
        navbar.classList.remove("scrolled");
    }
});

// =================
// INITIAL QUERY FROM URL
// =================
window.addEventListener("DOMContentLoaded", () => {
    const params = new URLSearchParams(window.location.search);
    const query = params.get("query");

    if (!query) return;

    handleSearchChange(query);
});

// =================
// FLOATING SEARCH BUTTON ON SCROLL
// =================
window.addEventListener("DOMContentLoaded", () => {
    let scrollTimeout;

    window.addEventListener("scroll", () => {
        if (sub.innerHTML.trim() === "" && textarea.value.trim() === "") return;

        floatingBtn.classList.remove("show");
        clearTimeout(scrollTimeout);

        scrollTimeout = setTimeout(() => {
            floatingBtn.classList.add("show");
        }, 300);
    });
});

// =================
// SUB DROPDOWN CLEANUP
// =================
function DeleteSubDropdown() {
    const activeCategory = document.querySelector(".category.active");

    if (activeCategory) {
        activeCategory.click();
    }

    sub.style.display = "none";
    document.getElementById("subDropdown").innerHTML = "";
}
