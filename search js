svg.style.top =  
    "70%";  

svg.style.width =  
    "110%";  

svg.style.height =  
    "180%";  

svg.style.pointerEvents =  
    "none";  

svg.style.opacity =  
    opacity;  
    
    svg.style.mixBlendMode =
