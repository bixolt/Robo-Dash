/* ================= BODY ================= */
body{
    margin:0;
    min-height:100vh;

    font-family:
        Inter,
        "SF Pro Display",
        Arial,
        sans-serif;
background: bleck;

background:#121212;
background-attachment:fixed;
background-repeat:no-repeat;
background-size:cover;
}

/* ================= NAVBAR ================= */
.top-navbar{
    position:sticky;
    top:0;
    z-index:1000;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:14px 24px;

    background:rgba(16,16,16,.96);

    backdrop-filter:blur(22px);
    -webkit-backdrop-filter:blur(22px);

    border-bottom:1px solid rgba(255,255,255,.08);

    box-shadow:
        0 10px 35px rgba(0,0,0,.35),
        inset 0 1px 0 rgba(16,16,16,.85);

    transition:
        transform .25s ease,
        opacity .25s ease;
}

.top-navbar.scrolled{
    transform:translateY(-110%);
    opacity:0;
    pointer-events:none;
}

.top-navbar::before{
    content:"";
    position:absolute;
    inset:0;

    background:
        linear-gradient(
            90deg,
            rgba(16,16,16,.35),
            rgba(16,16,16,.15),
            transparent
        );

    pointer-events:none;
}

/* ================= LOGO ================= */

.top-navbar .logo{
    font-weight:200;
    font-size:15px;

    color:#ffffff;

    letter-spacing:.5px;

    -webkit-text-fill-color:initial;
    background:none;
}

/* ================= NAV LINKS ================= */

.nav-links{
    display:flex;
    gap:20px;
    align-items:center;
}

.nav-links a{
    position:relative;

    padding:6px 4px;

    font-size:13px;
    font-weight:300;

    color:#8a8a8a;

    text-decoration:none;

    transition:
        color .25s ease,
        transform .25s ease;
}

.nav-links a::after{
    content:"";

    position:absolute;

    left:0;
    bottom:-4px;

    width:0;
    height:2px;

    border-radius:999px;

    background:#ffffff;

    transition:width .3s ease;
}

.nav-links a:hover{
    color:#d5d5d5;
    transform:translateY(-1px);
}

.nav-links a:hover::after{
    width:100%;
}

.nav-links a:active{
    transform:scale(.96);
}

/* ================= TITLE ================= */
.search-label{
    position:relative;

    display:flex;
    justify-content:center;
    align-items:center;

    margin-top:55px;
    margin-bottom:35px;

    font-family:"SF Pro Display","Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;

    font-size:clamp(30px,4vw,52px);
    font-weight:200;
    letter-spacing:-0.05em;
    line-height:1.05;

    text-align:center;

    background:
    linear-gradient(
        90deg,
        #5f5f5f 0%,
        #747474 22%,
        #c8c8c8 50%,
        #747474 78%,
        #5f5f5f 100%
    );

    background-size:220% 100%;

    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;

    animation:
        grayFlow 12s ease-in-out infinite,
        grayFloat 7s ease-in-out infinite;
}

.search-label::before{
    content:"";

    position:absolute;

    left:50%;
    top:50%;

    width:72%;
    height:160%;

    transform:translate(-50%,-50%);

    border-radius:999px;

    background:
        radial-gradient(
            circle,
            rgba(200,200,200,.012),
            transparent 75%
        );

    filter:blur(26px);

    z-index:-2;

    animation:grayAura 12s ease-in-out infinite;
}

.search-label::after{
    content:"";

    position:absolute;

    left:50%;
    bottom:-16px;

    transform:translateX(-50%);

    width:120px;
    height:1px;

    border-radius:999px;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,.08),
            rgba(255,255,255,.18),
            rgba(255,255,255,.08),
            transparent
        );

    opacity:.25;

    animation:grayLine 10s linear infinite;
}

.search-label span{
    position:relative;
}

.search-label span::before{
    content:"";

    display:none;
}

@keyframes grayFlow{

    0%{
        background-position:0% 50%;
    }

    50%{
        background-position:100% 50%;
    }

    100%{
        background-position:220% 50%;
    }

}

@keyframes grayLine{

    0%{
        opacity:.15;
    }

    50%{
        opacity:.28;
    }

    100%{
        opacity:.15;
    }

}

@keyframes grayFloat{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-1px);
    }

}

@keyframes grayAura{

    0%,100%{
        opacity:.03;
        transform:translate(-50%,-50%) scale(1);
    }

    50%{
        opacity:.07;
        transform:translate(-50%,-50%) scale(1.015);
    }

}

