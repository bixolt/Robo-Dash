    0%{
        border-radius:
            52% 48% 58% 42% /
            42% 57% 43% 58%;
    }

    25%{
        border-radius:
            63% 37% 46% 54% /
            54% 42% 58% 46%;
    }

    50%{
        border-radius:
            40% 60% 52% 48% /
            61% 38% 62% 39%;
    }

    75%{
        border-radius:
            57% 43% 63% 37% /
            44% 58% 42% 56%;
    }

    100%{
        border-radius:
            52% 48% 58% 42% /
            42% 57% 43% 58%;
    }

}



@keyframes brushTextFloat{

    0%,
    100%{

        transform:translateY(0);

    }

    50%{

        transform:translateY(-2px);

    }

}



@keyframes dropPaint{

    from{

        opacity:0;

        transform:

            translateY(-12px)

            scale(.95);

    }


    to{

        opacity:1;

        transform:

            translateY(0)

            scale(1);

    }

}