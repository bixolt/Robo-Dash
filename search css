/* ================= BODY ================= */
body{
    margin:0;
    min-height:100vh;

    font-family:
        Inter,
        "SF Pro Display",
        Arial,
        sans-serif;


background:#121212;
background-attachment:fixed;
background-repeat:no-repeat;
background-size:cover;
}

/* ================= NAVBAR ================= */
/* ================= NAVBAR ================= */

.top-navbar{
    position:sticky;
    top:0;
    z-index:1000;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:14px 24px;

    background:#121212;

    border-bottom:1px solid #2a2a2a;
}

/* ================= LOGO ================= */

.top-navbar .logo{
    font-weight:100;
    font-size:15px;

    color:#c9c9c9;

    letter-spacing:.5px;
}

/* ================= NAV LINKS ================= */

.nav-links{
    display:flex;
    gap:20px;
    align-items:center;
}

.nav-links a{
    position:relative;

    padding:6px 4px;

    font-size:13px;
    font-weight:200;

    color:#7d7d7d;

    text-decoration:none;

    transition:color .2s ease;
}

.nav-links a::after{
    content:"";

    position:absolute;

    left:0;
    bottom:-4px;

    width:0;
    height:1px;

    background:#9b9b9b;

    transition:width .25s ease;
}

.nav-links a:hover{
    color:#cfcfcf;
}

.nav-links a:hover::after{
    width:100%;
}

/* ================= TITLE ================= */
.search-label{
    position:relative;

    display:flex;
    justify-content:center;
    align-items:center;

    margin-top:55px;
    margin-bottom:35px;

    font-family:"SF Pro Display","Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;

    font-size:clamp(30px,4vw,52px);
    font-weight:200;
    letter-spacing:-0.05em;
    line-height:1.05;

    text-align:center;

    background:
    linear-gradient(
        90deg,
        #6a6a6a 0%,
        #7a7a7a 22%,
        #9c9c9c 50%,
        #7a7a7a 78%,
        #6a6a6a 100%
    );

    background-size:220% 100%;

    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;

    animation:
        grayFlow 12s ease-in-out infinite,
        grayFloat 7s ease-in-out infinite;
}

.search-label::before{
    content:"";

    position:absolute;

    left:50%;
    top:50%;

    width:72%;
    height:160%;

    transform:translate(-50%,-50%);

    border-radius:999px;

    background:
        radial-gradient(
            circle,
            rgba(200,200,200,.012),
            transparent 75%
        );

    filter:blur(26px);

    z-index:-2;

    animation:grayAura 12s ease-in-out infinite;
}

.search-label::after{
    content:"";

    position:absolute;

    left:50%;
    bottom:-16px;

    transform:translateX(-50%);

    width:120px;
    height:1px;

    border-radius:999px;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,.08),
            rgba(255,255,255,.18),
            rgba(255,255,255,.08),
            transparent
        );

    opacity:.25;

    animation:grayLine 10s linear infinite;
}

.search-label span{
    position:relative;
}

.search-label span::before{
    content:"";

    display:none;
}

@keyframes grayFlow{

    0%{
        background-position:0% 50%;
    }

    50%{
        background-position:100% 50%;
    }

    100%{
        background-position:220% 50%;
    }

}

@keyframes grayLine{

    0%{
        opacity:.15;
    }

    50%{
        opacity:.28;
    }

    100%{
        opacity:.15;
    }

}

@keyframes grayFloat{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-1px);
    }

}

@keyframes grayAura{

    0%,100%{
        opacity:.03;
        transform:translate(-50%,-50%) scale(1);
    }

    50%{
        opacity:.07;
        transform:translate(-50%,-50%) scale(1.015);
    }

}

