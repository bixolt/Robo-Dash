    justify-content:center;

    gap:20px;

    font-size:12px;
}

.bottom-footer a{

    color:#7a8ca5;

    text-decoration:none;

    transition:.15s ease;
}

.bottom-footer a:hover{
    color:#00b5f1;
}

/* =========================================
   FLOAT BUTTON
========================================= */
#floatingSearchBtn{

    position:fixed;

    bottom:20px;

    right:20px;
    font-family:"SF Pro Display","Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;

    padding:14px 24px;


    border-radius:16px;


    background:#ffffff;


    color:#111111;


    font-size:14px;

    font-weight:600;


    cursor:pointer;


    border:

        1px solid rgba(140,145,155,.30);





    opacity:0;

    visibility:hidden;


    transform:

        translateY(15px);


    transition:

        .22s ease;
}



#floatingSearchBtn.show{

    opacity:1;

    visibility:visible;


    transform:

        translateY(0);

}



#floatingSearchBtn:hover{
    border:

        1px solid rgba(0,0,0,.75);
    


}



/* =========================================
   ANIMATIONS
========================================= */


@keyframes paintBlob{

    0%{
        border-radius:
            52% 48% 58% 42% /
            42% 57% 43% 58%;
    }

    25%{
        border-radius:
            63% 37% 46% 54% /
            54% 42% 58% 46%;
    }

    50%{
        border-radius:
            40% 60% 52% 48% /
            61% 38% 62% 39%;
    }

    75%{
        border-radius:
            57% 43% 63% 37% /
            44% 58% 42% 56%;
    }

    100%{
        border-radius:
            52% 48% 58% 42% /
            42% 57% 43% 58%;
    }

}



@keyframes brushTextFloat{

    0%,
    100%{

        transform:translateY(0);

    }

    50%{

        transform:translateY(-2px);

    }

}



@keyframes dropPaint{

    from{

        opacity:0;

        transform:

            translateY(-12px)

            scale(.95);

    }


    to{

        opacity:1;

        transform:

            translateY(0)

            scale(1);

    }

}