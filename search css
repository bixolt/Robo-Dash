/* =========================
   Clear Button
========================= */


.clear-btn{

    position:absolute;

    top:50%;

    right:20px;

    z-index:2;

    display:none;

    align-items:center;

    justify-content:center;

    width:22px;

    height:22px;

    cursor:pointer;

    border:none;

    border-radius:32%;

    background:#101010;

    color:gray;

    font-size:25px;

    font-weight:100;

    border:
        0.2px solid rgba(85,85,85,.45);

    padding:0;

    transform:translateY(-50%);
}

.clear-btn span{

    display:flex;

    align-items:center;

    justify-content:center;

    width:100%;

    height:100%;

    padding:0;

    margin:0;

    line-height:1;

    transform:
        translate(0.5px, -2px);

    user-select:none;

    pointer-events:none;
}

.clear-btn:hover{

    transform:
        translateY(-50%)
        scale(1.05);
        color:#f3f3f3;
}

