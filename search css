/* ================= SHOW MORE ================= */

.show-more {

    margin-top:12px;

    font-size:12px;

    font-weight:100;

    color:#777777;

    cursor:pointer;

    display:inline-flex;

    align-items:center;

    gap:4px;
}

.show-more:hover {

    color:#b5b5b5;

    transform:
        translateX(3px);
}

.price-range{
    position:relative;
    width:100%;
    padding:50px 8px 10px;
    box-sizing:border-box;
    top:125px;
    display:flex;
    flex-direction:column;
    gap:22px;
    background:transparent;
}

.price-field{
    display:flex;
    flex-direction:column;
    gap:6px;
    margin-top:50px;
}

.price-field label{
    font-size:14px;
    font-weight:200;
    color:#8a8a8a;
    padding-left:2px;
}

.price-range::before{

    content:"";

    position:absolute;

    left:2px;
    right:2px;

    top:22px;

    height:0px;

    border-radius:999px;

    z-index:1;

    background:
        linear-gradient(
            90deg,
            var(--before-range-line-bg,#121212),
            var(--before-range-line-bg,#121212),
            var(--before-range-line-bg,#121212),
            var(--before-range-line-bg,#121212),
            var(--before-range-line-bg,#121212)
        );

    border:
        var(--before-range-line-border,
        1px solid rgba(90,90,90,.75));

}
.price-range::after{

    content:"";

    position:absolute;

    left:calc(2px + var(--min));

    right:calc(99.5% - var(--max));

    top:22px;
    border-radius:999px;

    z-index:2;

    background:
        linear-gradient(
            90deg,
            var(--after-range-line-bg,#121212),
            var(--after-range-line-bg,#121212),
            var(--after-range-line-bg,#121212)
        );

    border:
        var(--after-range-line-border,
        1px solid rgba(90,90,90,.85));

}
/* ================= FLOATING DOT WAVES ================= */

.bar{
    position: absolute;

    /* התחלה */
    left: calc(1px + var(--min));
    top: -21px;

    /* סוף */
    right: calc(99.5% - var(--max));

    height: 150px;

    overflow: hidden;

}
.bar::before{
    content: "";

    position: absolute;

    inset: 0;

    border-radius: inherit;

    pointer-events: none;



    z-index: 4;
}

/* =========================================
   INNER
========================================= */
.bar-inner{
    position: absolute;
    inset: 0;
    top:-5px ;
    overflow: hidden;
    pointer-events: none;

    z-index: 2;

    border-radius: inherit;

    height: 50px;
}

/* =========================================
   WAVE
========================================= */
.min-slider,
.max-slider{
    width:100%;
    position:absolute;
    left:0;
    top:-4px;
    transform:translateY(-40%);
    pointer-events:none;
    -webkit-appearance:none;
    appearance:none;
    background:transparent;
    z-index:30;
}
/* ==================================================
   MINIMAL DARK / GRAY BORDER STYLE
   ================================================== */

.min-slider::-webkit-slider-thumb,
.max-slider::-webkit-slider-thumb{

    pointer-events:all;
    -webkit-appearance:none;
    appearance:none;

    width:1px;
    height:42px;

    cursor:pointer;
    border-radius:999px;

    background:var(--slider-thumb-bg,#121212);

    border:var(--slider-thumb-border,
    1px solid rgba(90,90,90,.85));

}


/* active */

.min-slider::-webkit-slider-thumb:active,
.max-slider::-webkit-slider-thumb:active{
    
    background:#050505;
}

