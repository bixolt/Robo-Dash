    letter-spacing:0.3px;

    color:gray;

    border:0.8px solid rgba(72,76,84,.55);

}

.price-values input::placeholder{
    color:#8b8b8b;
    font-weight:200;
}

.price-values input:hover{
    background:#0b0b0b;
}

.price-values input:focus{

    color:#f5f5f5;

    background:#050505;
}

