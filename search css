.price-range {
    position: relative;
    width: 100%;
    padding: 50px 8px 10px;
    box-sizing: border-box;
    top: 125px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    background: transparent;
}


.price-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 50px;
}


.price-field label {
    font-size: 12px;
    font-weight: 600;
    color: #8a8a8a;
    padding-left: 2px;
}


.price-range::before {

    content: "";

    position: absolute;

    left: 8px;
    right: 8px;
    top: 22px;

    height: 2px;

    border-radius:999px;

    z-index:1;

    background:
        linear-gradient(
            90deg,
            #ffffff,
            #eeeeee,
            #ffffff,
            #e8e8e8,
            #ffffff
        );

    border:
        1px solid rgba(0,0,0,.75);

    box-shadow:
        0 1px 5px rgba(0,0,0,.25),
        inset 0 1px 2px rgba(255,255,255,.9);
}


.price-range::after {

    content: "";

    position:absolute;

    left:calc(8px + var(--min) - 5px);
    right:calc(100% - var(--max));

    top:22px;

    height:2px;

    border-radius:999px;

    z-index:2;

    background:
        linear-gradient(
            90deg,
            #ffffff,
            #f5f5f5,
            #ffffff
        );

    border:
        1px solid rgba(0,0,0,.85);

    box-shadow:
        0 0 8px rgba(0,0,0,.25),
        inset 0 1px 2px rgba(255,255,255,.95);
}
/* ================= FLOATING DOT WAVES ================= */

.bar{
    position: absolute;

    /* התחלה */
    left: calc(4px + var(--min) - 1px);
    top: -21px;

    /* סוף */
    right: calc(100% - var(--max));

    height: 150px;

    overflow: hidden;




}
.bar::before{
    content: "";

    position: absolute;

    inset: 0;

    border-radius: inherit;

    pointer-events: none;

    box-shadow:
        inset 0 0 22px rgba(255,255,255,.15),
        0 0 24px rgba(0,180,255,.12);

    z-index: 4;
}

/* =========================================
   INNER
========================================= */
.bar-inner{
    position: absolute;
    inset: 0;
    top:-5px ;
    overflow: hidden;
    pointer-events: none;

    z-index: 2;

    border-radius: inherit;

    height: 50px;
}

/* =========================================
   WAVE
========================================= */
.min-slider,
.max-slider{
    width:100%;
    position:absolute;
    left:0;
    top:-10px;
    transform:translateY(-40%);
    pointer-events:none;
    -webkit-appearance:none;
    appearance:none;
    background:transparent;
    z-index:30;
}


/* ==================================================
   MINIMAL WHITE / BLACK BORDER STYLE
   ================================================== */

.min-slider::-webkit-slider-thumb,
.max-slider::-webkit-slider-thumb{

    pointer-events:all;

    -webkit-appearance:none;
    appearance:none;

    width:4px;
    height:55px;

    cursor:pointer;

    border-radius:999px;

    background:#ffffff;

    border:
        1px solid rgba(0,0,0,.85);

    box-shadow:
        inset 0 1px 2px rgba(255,255,255,.9),
        inset 0 -2px 4px rgba(0,0,0,.15),
        0 4px 14px rgba(0,0,0,.25),
        0 0 0 1px rgba(0,0,0,.08);
}


/* hover */

.min-slider::-webkit-slider-thumb:hover,
.max-slider::-webkit-slider-thumb:hover{

    transform:scaleX(1.08);

    box-shadow:
        inset 0 1px 3px rgba(255,255,255,1),
        inset 0 -3px 6px rgba(0,0,0,.18),
        0 0 18px rgba(0,0,0,.18),
        0 6px 18px rgba(0,0,0,.28);
}


/* active */

.min-slider::-webkit-slider-thumb:active,
.max-slider::-webkit-slider-thumb:active{

    transform:scaleX(1.15);

    box-shadow:
        inset 0 1px 4px rgba(255,255,255,1),
        inset 0 -4px 8px rgba(0,0,0,.25),
        0 0 25px rgba(0,0,0,.22),
        0 8px 22px rgba(0,0,0,.35);
}


/* Firefox */

.min-slider::-moz-range-thumb,
.max-slider::-moz-range-thumb{

    width:4px;
    height:55px;

    border:none;

    cursor:pointer;

    border-radius:999px;

    background:#ffffff;

    border:
        1px solid rgba(0,0,0,.85);

    box-shadow:
        inset 0 1px 2px rgba(255,255,255,.9),
        inset 0 -2px 4px rgba(0,0,0,.15),
        0 4px 14px rgba(0,0,0,.25),
        0 0 0 1px rgba(0,0,0,.08);
}
