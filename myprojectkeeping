const minSlider = document.querySelector(".min-slider");
const maxSlider = document.querySelector(".max-slider");
const minInput  = document.querySelector(".min-input");
const maxInput  = document.querySelector(".max-input");
const range = document.querySelector(".price-range");


if (minSlider && maxSlider && minInput && maxInput) {

    const ABS_MIN = parseInt(minSlider.min) || 0;
    const ABS_MAX = parseInt(maxSlider.max) || 10000;

    const updateBars = () => {

        const min = parseInt(minSlider.value);
        const max = parseInt(maxSlider.value);
        
    const minPercent = ((min - ABS_MIN) / (ABS_MAX - ABS_MIN)) * 100;
    const maxPercent = ((max - ABS_MIN) / (ABS_MAX - ABS_MIN)) * 100;

    range.style.setProperty("--min", minPercent + "%");
    range.style.setProperty("--max", maxPercent + "%");
   

    };
    
minSlider.addEventListener("input", updateBars);
maxSlider.addEventListener("input", updateBars);

    const update = () => {

        let min = parseInt(minSlider.value);
        let max = parseInt(maxSlider.value);

        if (min > max) min = max;
        if (max < min) max = min;

        minSlider.value = min;
        maxSlider.value = max;

        minInput.value = min;
        maxInput.value = max;

        updateBars();
    };

    const applyMinInput = () => {
        let val = parseInt(minInput.value);

        if (isNaN(val)) val = ABS_MIN;
        if (val < ABS_MIN) val = ABS_MIN;
        if (val > parseInt(maxSlider.value)) {
            val = parseInt(maxSlider.value);
        }

        minSlider.value = val;
        update();
    };

    const applyMaxInput = () => {
        let val = parseInt(maxInput.value);

        if (isNaN(val)) val = ABS_MAX;
        if (val > ABS_MAX) val = ABS_MAX;
        if (val < parseInt(minSlider.value)) {
            val = parseInt(minSlider.value);
        }

        maxSlider.value = val;
        update();
    };

    minSlider.oninput = update;
    maxSlider.oninput = update;

    minInput.addEventListener("keydown", e => {
        if (e.key === "Enter") applyMinInput();
    });

    maxInput.addEventListener("keydown", e => {
        if (e.key === "Enter") applyMaxInput();
    });

    minInput.addEventListener("blur", applyMinInput);
    maxInput.addEventListener("blur", applyMaxInput);

    update();
}

