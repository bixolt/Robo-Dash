<!DOCTYPE html>
<html lang="he">
<head>
<meta charset="UTF-8">
<title>Search</title>

<style>

/* ================= BODY ================= */
body {
    margin: 0;
    font-family: 'Inter', Arial, sans-serif;
    color: #1f2937;

    background: linear-gradient(
        180deg,
        #f7f9fc 0%,
        #eef2f7 55%,
        #e6edf6 100%
    );

    background-attachment: fixed;
}

/* סיסטם חלק */
* {
    -webkit-tap-highlight-color: transparent;
    box-sizing: border-box;
}

/* ================= NAVBAR ================= */
.top-navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 14px 24px;

    background: rgba(255,255,255,0.55);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);

    border-bottom: 1px solid rgba(0,0,0,0.05);

    box-shadow:
        0 10px 35px rgba(0,0,0,0.07),
        0 1px 0 rgba(255,255,255,0.7) inset;

    transition: transform 0.25s ease, opacity 0.25s ease;
}

.top-navbar.scrolled {
    transform: translateY(-110%);
    opacity: 0;
    pointer-events: none;
}

.top-navbar::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        90deg,
        rgba(0,114,255,0.06),
        rgba(0,198,255,0.04),
        transparent
    );
    pointer-events: none;
}

.top-navbar .logo {
    font-weight: 800;
    font-size: 15px;

    background: linear-gradient(90deg, #0072ff, #00c6ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    letter-spacing: 0.5px;
}

/* ================= NAV LINKS ================= */
.nav-links {
    display: flex;
    gap: 20px;
    align-items: center;
}

.nav-links a {
    font-size: 13px;
    color: #6b7280;
    text-decoration: none;

    position: relative;
    padding: 6px 4px;

    transition: all 0.25s ease;
}

.nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;

    width: 0%;
    height: 2px;
    border-radius: 999px;

    background: linear-gradient(90deg, #0072ff, #00c6ff);

    transition: width 0.3s ease;
}

.nav-links a:hover {
    color: #0072ff;
    transform: translateY(-1px);
}

.nav-links a:hover::after {
    width: 100%;
}

/* אפקט עדין של עומק בלינקים */
.nav-links a:active {
    transform: scale(0.96);
}

/* ================= TITLE ================= */
.search-label{
    position:relative;

    display:flex;
    justify-content:center;
    align-items:center;

    margin-top:55px;
    margin-bottom:35px;

    font-size:clamp(28px,4vw,48px);
    font-weight:900;

    letter-spacing:-1.2px;
    line-height:1.05;

    text-align:center;

    background:
        linear-gradient(
            90deg,
            #4285F4 0%,
            #6FAEFF 12%,
            #34A853 28%,
            #86E56F 42%,
            #FBBC05 58%,
            #FFE27A 70%,
            #EA4335 86%,
            #FF8F84 100%
        );

    background-size:300% 100%;

    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;

    filter:
        drop-shadow(0 0 12px rgba(66,133,244,.18))
        drop-shadow(0 0 20px rgba(52,168,83,.10));

    animation:
        googleTextFlow 10s linear infinite,
        googleFloat 6s ease-in-out infinite;
}

/* glass aura */
.search-label::before{
    content:"";

    position:absolute;

    width:140%;
    height:220%;

    left:50%;
    top:50%;

    transform:
        translate(-50%,-50%);

    border-radius:999px;

    background:
        radial-gradient(
            circle,
            rgba(66,133,244,.12),
            rgba(52,168,83,.08),
            rgba(251,188,5,.06),
            transparent 70%
        );

    filter:blur(45px);

    z-index:-2;

    animation:
        googleAura 8s ease-in-out infinite;
}

/* premium animated underline */
.search-label::after{
    content:"";

    position:absolute;

    left:50%;
    bottom:-16px;

    transform:
        translateX(-50%);

    width:180px;
    height:4px;

    border-radius:999px;

    background:
        linear-gradient(
            90deg,
            #4285F4,
            #34A853,
            #FBBC05,
            #EA4335,
            #4285F4
        );

    background-size:300% 100%;

    box-shadow:
        0 0 10px rgba(66,133,244,.25),
        0 0 20px rgba(52,168,83,.18),
        0 0 30px rgba(234,67,53,.12);

    animation:
        googleLineFlow 4s linear infinite;
}

/* top sparkle */
.search-label span{
    position:relative;
}

.search-label span::before{
    content:"✦";

    position:absolute;

    top:-18px;
    right:-22px;

    font-size:14px;

    background:
        linear-gradient(
            135deg,
            #4285F4,
            #34A853,
            #FBBC05,
            #EA4335
        );

    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;

    animation:
        sparklePulse 2.5s ease-in-out infinite;
}

@keyframes googleTextFlow{

    0%{
        background-position:0% 50%;
    }

    100%{
        background-position:300% 50%;
    }
}

@keyframes googleLineFlow{

    0%{
        background-position:0% 50%;
    }

    100%{
        background-position:300% 50%;
    }
}

@keyframes googleFloat{

    0%{
        transform:translateY(0px);
    }

    50%{
        transform:translateY(-2px);
    }

    100%{
        transform:translateY(0px);
    }
}

@keyframes googleAura{

    0%{
        opacity:.65;
        transform:
            translate(-50%,-50%)
            scale(1);
    }

    50%{
        opacity:1;
        transform:
            translate(-50%,-50%)
            scale(1.08);
    }

    100%{
        opacity:.65;
        transform:
            translate(-50%,-50%)
            scale(1);
    }
}

@keyframes sparklePulse{

    0%{
        opacity:.4;
        transform:
            scale(.8)
            rotate(0deg);
    }

    50%{
        opacity:1;
        transform:
            scale(1.25)
            rotate(25deg);
    }

    100%{
        opacity:.4;
        transform:
            scale(.8)
            rotate(0deg);
    }
}

/* ================= SEARCH ================= */
.search-box {
    display: flex;
    justify-content: center;
    margin: 34px 15px;
    position: relative;
}

.search-box textarea {
    width: 92vw;
    max-width: 720px;
    height: 120px;

    padding: 20px 22px;
    border-radius: 24px;

    border: 1px solid rgba(0,0,0,0.06);
    outline: none;

    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    box-shadow:
        0 18px 50px rgba(0,0,0,0.08),
        0 1px 0 rgba(255,255,255,0.7) inset;

    font-size: 15px;
    resize: none;

    transition: all 0.25s ease;
}

.search-box textarea:focus {
    transform: translateY(-3px);
    border: 3px solid rgba(0,114,255,0.25);

    background:
        linear-gradient(
            rgba(255,255,255,1),
            rgba(255,255,255,1)
        ) padding-box,

        conic-gradient(
            from var(--angle),
            #4285f4,
            #5b9cff,
            #34a853,
            #7bdc6b,
            #fbbc05,
            #ffd95a,
            #ea4335,
            #ff7a70,
            #4285f4
        ) border-box;

    animation:
        googleBorderSpin 5s linear infinite;

    transform:translateY(-2px);

    box-shadow:
        0 25px 70px rgba(66,133,244,.15),
        0 0 0 4px rgba(66,133,244,.06),
        0 0 30px rgba(52,168,83,.08),
        0 0 35px rgba(234,67,53,.06);
}
.search-box textarea{
    width:92vw;
    max-width:720px;
    height:120px;

    padding:20px 22px;
    border-radius:24px;

    border:2px solid transparent;
    outline:none;

    background:
        linear-gradient(
            rgba(255,255,255,.88),
            rgba(255,255,255,.88)
        ) padding-box,

        conic-gradient(
            from var(--angle),
            #4285f4,
            #5b9cff,
            #34a853,
            #7bdc6b,
            #fbbc05,
            #ffd95a,
            #ea4335,
            #ff7a70,
            #4285f4
        ) border-box;

    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);

    box-shadow:
        0 18px 50px rgba(0,0,0,.08),
        0 1px 0 rgba(255,255,255,.7) inset,
        0 0 20px rgba(66,133,244,.08);

    font-size:15px;
    resize:none;

    animation:
        googleBorderSpin 12s linear infinite,
        googleGlow 5s ease-in-out infinite;

    transition:
        transform .35s ease,
        box-shadow .35s ease;
}

.search-box textarea:focus{
    transform:translateY(-2px);

    box-shadow:
        0 25px 70px rgba(66,133,244,.15),
        0 0 0 4px rgba(66,133,244,.06),
        0 0 30px rgba(52,168,83,.08),
        0 0 35px rgba(234,67,53,.06);

    animation:
        googleBorderSpin 5s linear infinite,
        googleGlow 3s ease-in-out infinite;
}

@keyframes googleGlow{

    0%{
        filter:
            brightness(1)
            saturate(1);
    }

    50%{
        filter:
            brightness(1.06)
            saturate(1.12);
    }

    100%{
        filter:
            brightness(1)
            saturate(1);
    }
}

@property --angle{
    syntax:"<angle>";
    inherits:false;
    initial-value:0deg;
}

@keyframes googleBorderSpin{

    0%{
        --angle:0deg;
    }

    100%{
        --angle:360deg;
    }
}
/* ================= CLEAR BTN ================= */
.clear-btn {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%) scale(0.85);

    font-size: 18px;
    cursor: pointer;

    display: none;
    color: #9ca3af;

    transition: all 0.2s ease;
}

.clear-btn:hover {
    color: #111827;
    transform: translateY(-50%) scale(1.15);
}

/* ================= DROPDOWN ================= */
.dropdown {
    width: 92%;
    max-width: 560px;
    margin: 30px auto;
}

/* ================= MAIN SEARCH ================= */
.dropdown-search {
    width: 100%;
    padding: 15px 18px;

    border-radius: 16px;
    border: 1px solid rgba(0,0,0,0.06);

    font-size: 14px;
    outline: none;

    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);

    box-shadow:
        0 14px 40px rgba(0,0,0,0.06),
        0 1px 0 rgba(255,255,255,0.7) inset;

    transition: all 0.2s ease;
}

.dropdown-search:focus {
    border-color: rgba(0,198,255,0.35);

    box-shadow:
        0 18px 55px rgba(0,114,255,0.12),
        0 0 0 3px rgba(0,198,255,0.10);
}

/* ================= DROPDOWN LIST ================= */
.dropdown-list {
    margin-top: 12px;

    background: rgba(255,255,255,0.82);
    border-radius: 18px;

    max-height: 280px;
    overflow-y: auto;

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border: 1px solid rgba(0,0,0,0.04);

    box-shadow:
        0 22px 60px rgba(0,0,0,0.08),
        0 2px 0 rgba(255,255,255,0.7) inset;

    display: none;

    animation: fadeIn 0.18s ease;
}

.dropdown.open .dropdown-list {
    display: block;
}

/* ================= ITEMS ================= */
.dropdown-item {
    padding: 14px 16px;

    cursor: pointer;
    border-radius: 12px;

    display: flex;
    align-items: center;

    font-size: 14px;

    transition: all 0.18s ease;
}

.dropdown-item:hover {
    background: linear-gradient(135deg, #effcff, #e6f7ff);

    transform: translateX(4px);

    box-shadow:
        0 6px 14px rgba(0,0,0,0.06);
}

/* scrollbar */
.dropdown-list::-webkit-scrollbar {
    width: 6px;
}

.dropdown-list::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 999px;
}

/* ================= SUB FILTER ================= */
#subDropdown {
    margin-top: 16px;

    background: rgba(255,255,255,0.88);
    border-radius: 20px;

    padding: 18px;

    backdrop-filter: blur(14px);

    border: 1px solid rgba(0,0,0,0.04);

    box-shadow:
        0 20px 50px rgba(0,0,0,0.07),
        0 1px 0 rgba(255,255,255,0.7) inset;
}

/* ================= FILTER GROUP ================= */
.filter-group {
    margin-bottom: 18px;
}

.filter-title {
    font-weight: 600;
    margin-bottom: 10px;

    font-size: 12px;
    letter-spacing: 0.6px;
    text-transform: uppercase;

    color: #6b7280;
}

/* ================= OPTIONS ================= */
.filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

/* pills */
.sub-item {
    padding: 9px 14px;

    background: #f1f5f9;

    border-radius: 999px;

    cursor: pointer;

    font-size: 13px;
    font-weight: 500;

    color: #334155;

    border: 1px solid rgba(0,0,0,0.05);

    transition: all 0.18s ease;
}

.sub-item:hover {
    background: #eaf6ff;

    transform: translateY(-1px);

    box-shadow:
        0 6px 12px rgba(0,0,0,0.06);
}

.sub-item.selected {
    background: linear-gradient(90deg, #0072ff, #00c6ff);
    color: #fff;

    border-color: transparent;

    box-shadow:
        0 10px 22px rgba(0,114,255,0.25);
}

/* ================= SUB SEARCH ================= */
.sub-search {
    width: 100%;
    padding: 10px 14px;

    margin: 12px 0;

    border-radius: 12px;

    border: 1px solid rgba(0,0,0,0.06);

    font-size: 13px;

    background: rgba(255,255,255,0.9);

    transition: all 0.18s ease;
}

.sub-search:focus {
    border-color: rgba(0,114,255,0.35);

    box-shadow:
        0 0 0 3px rgba(0,114,255,0.10);
}

/* ================= SHOW MORE ================= */
.show-more {
    margin-top: 12px;

    font-size: 12px;
    font-weight: 500;

    color: #6b7280;

    cursor: pointer;

    display: inline-flex;
    align-items: center;
    gap: 4px;

    transition: all 0.18s ease;
}

.show-more:hover {
    color: #111827;
    transform: translateX(3px);
}

/* ================= ANIMATION ================= */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(6px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}
.price-range {
    position: relative;
    width: 100%;
    padding: 50px 8px 10px;
    box-sizing: border-box;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    background: transparent;
}

.price-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 100px;
}

.price-field label {
    font-size: 12px;
    font-weight: 600;
    color: #6b7280;
    padding-left: 2px;
}

.price-range::before {
    content: "";
    position: absolute;
    left: 8px;
    right: 8px;
    top: 22px;
    height: 2px;
    border-radius: 999px;
    z-index: 1;

    background: linear-gradient(180deg, #effcff 0%, #8eeaff 100%);

    box-shadow:
        inset 0 1px 2px rgba(0,0,0,0.10),
        inset 0 -1px 2px rgba(255,255,255,0.7);
}

.price-range::after {
    content: "";
    position: absolute;
    left: calc(8px + var(--min));
    right: calc(100% - var(--max));
    top: 22px;
    height: 2px;
    border-radius: 999px;
    z-index: 2;

    background: linear-gradient(90deg, #8eeaff 0%, #54dbff 50%, #38cfff 100%);

    box-shadow:
        inset 0 1px 1px rgba(255,255,255,0.35),
        inset 0 -1px 2px rgba(0,0,0,0.12),
        0 2px 6px rgba(120,240,255,0.35);
}
/* ================= FLOATING DOT WAVES ================= */

.bar{
    position: absolute;

    /* התחלה */
    left: calc(4px + var(--min));
    top: -21px;

    /* סוף */
    right: calc(100% - var(--max));

    height: 150px;

    overflow: hidden;

    

    
}
.bar::before{
    content: "";

    position: absolute;

    inset: 0;

    border-radius: inherit;

    pointer-events: none;

    box-shadow:
        inset 0 0 22px rgba(255,255,255,.15),
        0 0 24px rgba(0,180,255,.12);

    z-index: 4;
}

/* =========================================
   INNER
========================================= */
.bar-inner{
    position: absolute;
    inset: 0;
    top:-5px ;
    overflow: hidden;
    pointer-events: none;

    z-index: 2;

    border-radius: inherit;
    
    height: 50px;
}

/* =========================================
   WAVE
========================================= */
.wave{
    position:absolute;

    left:0;
    top:20px;

    width:100%;
    height:34px;

    transform:translateY(-50%);
    transform-origin:center center;

    overflow:hidden;

    opacity:.98;
    isolation:isolate;
    pointer-events:none;

    will-change:
        transform,
        filter,
        clip-path;

    filter:
        blur(.12px)
        saturate(1.35)
        brightness(1.05);

    clip-path:
        polygon(
            0% 58%,
            4% 54%,
            8% 62%,
            12% 49%,
            16% 60%,
            20% 46%,
            24% 65%,
            28% 55%,
            32% 61%,
            36% 44%,
            40% 58%,
            44% 53%,
            48% 67%,
            52% 49%,
            56% 59%,
            60% 45%,
            64% 65%,
            68% 53%,
            72% 61%,
            76% 47%,
            80% 57%,
            84% 52%,
            88% 66%,
            92% 55%,
            96% 60%,
            100% 50%,
            100% 100%,
            0% 100%
        );

    animation:
        spotifySurface 4.5s ease-in-out infinite;
}

/* =========================================
   MAIN BODY
========================================= */
.wave::before{
    content:"";

    position:absolute;
    inset:-20%;

    background:
        linear-gradient(
            90deg,
            #ffffff 0%,
            #f6fffc 8%,
            #d4ffe9 18%,
            #97ffcb 30%,
            #4dff9f 45%,
            #1ed760 50%,
            #3fff8d 60%,
            #9cffcb 75%,
            #e7fff3 90%,
            #ffffff 100%
        );

    background-size:300% 100%;

    filter:blur(.25px);

    box-shadow:
        0 0 8px rgba(30,215,96,.25),
        0 0 18px rgba(30,215,96,.22),
        0 0 40px rgba(30,215,96,.18),
        0 0 70px rgba(30,215,96,.10),
        inset 0 2px 6px rgba(255,255,255,.35),
        inset 0 -4px 10px rgba(30,215,96,.20);

    animation:
        spotifyFlow 3.5s linear infinite,
        spotifyPulse 2.8s ease-in-out infinite;
}

/* =========================================
   GLOW + SHIMMER
========================================= */
.wave::after{
    content:"";

    position:absolute;
    inset:0;

    background:
        radial-gradient(
            circle at 10% 35%,
            rgba(255,255,255,.95),
            transparent 10%
        ),

        radial-gradient(
            circle at 35% 40%,
            rgba(255,255,255,.55),
            transparent 18%
        ),

        radial-gradient(
            circle at 65% 45%,
            rgba(255,255,255,.35),
            transparent 22%
        ),

        radial-gradient(
            circle at 88% 40%,
            rgba(255,255,255,.8),
            transparent 12%
        ),

        linear-gradient(
            180deg,
            rgba(255,255,255,.35),
            transparent 35%
        ),

        linear-gradient(
            90deg,
            rgba(255,255,255,.9) 0%,
            rgba(255,255,255,.1) 50%,
            rgba(255,255,255,.9) 100%
        );

    mix-blend-mode:screen;

    animation:
        spotifyShimmer 2.6s linear infinite,
        spotifyGlow 3s ease-in-out infinite;
}

/* =========================================
   FLOW
========================================= */
@keyframes spotifyFlow{
    0%{
        background-position:0% 0%;
    }

    100%{
        background-position:300% 0%;
    }
}

/* =========================================
   SURFACE
========================================= */
