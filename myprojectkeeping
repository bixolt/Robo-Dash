                100% 100%,
                0% 100%
            );
    }

    100%{
        clip-path:
            polygon(
                0% 58%,
                8% 63%,
                16% 54%,
                24% 66%,
                32% 48%,
                40% 58%,
                48% 67%,
                56% 55%,
                64% 63%,
                72% 50%,
