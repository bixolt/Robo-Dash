================================================== */

.currency-dropdown{
    display:none;

    position:absolute;
    top:calc(100% + 16px);

    width:180px;

    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,.94),
            rgba(247,252,255,.90)
