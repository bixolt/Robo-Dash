            180deg,
            rgba(255,255,255,.42),
            transparent 35%
        ),

        linear-gradient(
            90deg,
            rgba(255,255,255,.95),
            rgba(255,255,255,.08),
            rgba(255,255,255,.95)
        );

    mix-blend-mode:screen;

    animation:
        googleShimmer 2.5s linear infinite,
