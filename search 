/* =========================================
   WAVE
========================================= */
.wave{
    position:absolute;

    left:0;
    top:20px;

    width:100%;
    height:36px;

    transform:translateY(-50%);
    transform-origin:center center;

    overflow:hidden;

    pointer-events:none;
    isolation:isolate;

    opacity:.98;

    will-change:
        transform,
        filter,
        clip-path;

    filter:
        blur(.12px)
        saturate(1.35)
        brightness(1.04);

    clip-path:
        polygon(
            0% 58%,
            4% 52%,
            8% 64%,
            12% 48%,
            16% 61%,
            20% 45%,
            24% 66%,
            28% 54%,
            32% 62%,
            36% 46%,
            40% 57%,
            44% 51%,
            48% 68%,
            52% 48%,
            56% 60%,
            60% 45%,
            64% 67%,
            68% 54%,
            72% 62%,
            76% 47%,
            80% 58%,
            84% 52%,
            88% 66%,
            92% 54%,
            96% 61%,
            100% 50%,
            100% 100%,
            0% 100%
        );

    animation:
        googleSurface 5s ease-in-out infinite;
}

/* =========================================
   MAIN GOOGLE LIQUID
========================================= */
.wave::before{
    content:"";

    position:absolute;
    inset:-25%;

    background:
        linear-gradient(
            90deg,

            #4285F4 0%,
            #6EA8FF 8%,
            #8FC2FF 14%,

            #34A853 24%,
            #7BDC6B 33%,

            #FBBC05 46%,
            #FFE27A 56%,

            #EA4335 68%,
            #FF9B91 78%,

            #4285F4 90%,
            #8FC2FF 100%
        );

    background-size:400% 100%;

    filter:
        blur(.2px)
        saturate(1.3);

    box-shadow:
        0 0 10px rgba(66,133,244,.20),
        0 0 20px rgba(66,133,244,.18),
        0 0 35px rgba(52,168,83,.16),
        0 0 55px rgba(251,188,5,.14),
        0 0 85px rgba(234,67,53,.10),

        inset 0 2px 5px rgba(255,255,255,.35),
        inset 0 -4px 10px rgba(66,133,244,.12);

    animation:
        googleFlow 4s linear infinite,
        googleBreath 3.5s ease-in-out infinite;
}

/* =========================================
   PREMIUM GLASS SHINE
========================================= */
.wave::after{
    content:"";

    position:absolute;
    inset:0;

    background:

        radial-gradient(
            circle at 8% 35%,
            rgba(255,255,255,.95),
            transparent 10%
        ),

        radial-gradient(
            circle at 28% 45%,
            rgba(255,255,255,.55),
            transparent 18%
        ),

        radial-gradient(
            circle at 52% 40%,
