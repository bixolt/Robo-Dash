    font-weight:700;
    letter-spacing:1px;
    text-transform:uppercase;
    color:#7a8ca5;
}

/* =========================================================
   PREMIUM INPUT FIELD (PRICE VALUES)
   Clean Apple-like UI • Soft Depth • Subtle Glow • Smooth Feel
========================================================= */

.price-values input{

    width:100%;
    max-width:90px;
    height:75px;

    padding:0 12px;

    border:none;
    outline:none;

    border-radius:16px;

    background:
        linear-gradient(145deg, #ffffff, #f6fbff);

    text-align:center;

    font-size:18px;
    font-weight:500;
    letter-spacing:0.3px;

    color:#00a8e8;

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.9),
        0 10px 20px rgba(0,0,0,0.05),
        0 0 0 1px rgba(0,181,241,0.10);

    transition:
        transform 0.22s cubic-bezier(.2,.9,.2,1),
        box-shadow 0.22s ease,
        background 0.22s ease,
        color 0.22s ease;
}

/* hover floating */
.price-values input:hover{

    transform:
        translateY(-2px) scale(1.03);

    box-shadow:
        0 14px 28px rgba(0,0,0,0.08),
        0 0 0 1px rgba(0,181,241,0.18);
}

/* focus glow */
.price-values input:focus{

    color:#007fd1;

    background:
        linear-gradient(145deg, #ffffff, #eef9ff);

    box-shadow:
        0 0 0 4px rgba(0,181,241,0.12),
        0 18px 40px rgba(0,181,241,0.15);
}

/* =========================================
   CURRENCY
========================================= */
.currency-box{
    position:relative;
    display:flex;
    flex-direction:column;

    top:-320px;
    margin:-160px auto 10px;

    isolation:isolate;
}

/* ==================================================
   HEADER
================================================== */

.currency-header{
    padding:18px 20px;

    border-radius:24px;

    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,.95),
            rgba(245,251,255,.82)
        );

    backdrop-filter:blur(24px);
    -webkit-backdrop-filter:blur(24px);

    cursor:pointer;

    border:1px solid rgba(255,255,255,.65);

    box-shadow:
        0 20px 60px rgba(0,0,0,.08),
        0 8px 20px rgba(0,181,241,.08),
        inset 0 1px 0 rgba(255,255,255,.9),
        inset 0 -1px 0 rgba(255,255,255,.4);

    transition:
        transform .35s cubic-bezier(.22,1,.36,1),
        box-shadow .35s cubic-bezier(.22,1,.36,1),
        border-color .35s ease;

    position:relative;
    overflow:hidden;
    
    
}
.currency-box,
.currency-box *{
    font-family:
    "Space Grotesk",
    "Satoshi",
    "Manrope",
    "Inter",
    "SF Pro Display",
    sans-serif;
    font-weight: 300;
        font-size:18px;
}
/* glow layer */

.currency-header::before{
    content:"";

    position:absolute;
    inset:-40%;

    background:
        radial-gradient(
            circle,
            rgba(0,198,255,.22),
            transparent 70%
        );

    opacity:.4;

    animation:
        headerGlow 6s linear infinite;

    pointer-events:none;
}

/* premium shine */

.currency-header::after{
    content:"";

    position:absolute;
    inset:0;

    background:
        linear-gradient(
            115deg,
            transparent 20%,
            rgba(255,255,255,.08) 35%,
            rgba(255,255,255,.85) 50%,
            rgba(255,255,255,.08) 65%,
            transparent 80%
        );

    transform:translateX(-160%);
    animation:headerShine 4.5s ease-in-out infinite;
}

@keyframes headerShine{
    0%{
        transform:translateX(-160%);
    }

    35%{
        transform:translateX(180%);
    }

    100%{
        transform:translateX(180%);
    }
}

@keyframes headerGlow{
    0%{
        transform:
            rotate(0deg)
            scale(1);
    }

    50%{
        transform:
            rotate(180deg)
            scale(1.15);
    }

    100%{
        transform:
            rotate(360deg)
            scale(1);
    }
}

.currency-header:hover{
    transform:
        translateY(-4px)
        scale(1.015);

    border-color:
        rgba(0,181,241,.25);

    box-shadow:
        0 30px 80px rgba(0,181,241,.14),
        0 15px 35px rgba(0,0,0,.08),
        inset 0 1px 0 rgba(255,255,255,.95);
}

/* OPEN STATE */

.currency-box.open .currency-header{
    box-shadow:
        0 40px 100px rgba(0,181,241,.18),
        0 0 0 1px rgba(0,181,241,.18),
        inset 0 1px 0 rgba(255,255,255,.9);

    animation:
        headerPulse 2.4s ease-in-out infinite;
}

@keyframes headerPulse{
    0%,100%{
        transform:translateY(0);
    }

    20%{
        transform:translateY(-2px);
    }
}

/* ==================================================
   DROPDOWN
================================================== */

.currency-dropdown{
    display:none;

    position:absolute;
    top:calc(100% + 16px);

    width:180px;

    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,.94),
            rgba(247,252,255,.90)
        );

    backdrop-filter:blur(24px);

    border-radius:26px;

    padding:18px;

    z-index:50;

    border:
        1px solid rgba(255,255,255,.8);

    box-shadow:
        0 40px 120px rgba(0,0,0,.12),
        0 15px 35px rgba(0,181,241,.08);

    overflow:hidden;
}

.currency-dropdown::before{
    content:"";

    position:absolute;
    inset:0;

    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.35),
            transparent 40%
        );

    pointer-events:none;
}

.currency-box.open .currency-dropdown{
    display:block;

    animation:
        dropdownFloat .35s cubic-bezier(.22,1,.36,1);
}

@keyframes dropdownFloat{
    from{
        opacity:0;

        transform:
            translateY(-14px)
            scale(.96);
    }

    to{
        opacity:1;

        transform:
            translateY(0)
            scale(1);
    }
}

/* ==================================================
   SEARCH
================================================== */

.currency-search{
    width:100%;

    padding:14px 16px;

    border:none;
    outline:none;

    border-radius:18px;

    background:
        rgba(255,255,255,.85);

    box-shadow:
        inset 0 0 0 1px rgba(0,0,0,.05);

    margin-bottom:14px;

    transition:
        .28s cubic-bezier(.22,1,.36,1);
}

.currency-search::placeholder{
    color:#8aa2b8;
}

.currency-search:focus{
    background:#fff;

    transform:
        translateY(-2px)
        scale(1.01);

    box-shadow:
        0 0 0 4px rgba(0,181,241,.12),
        0 14px 35px rgba(0,181,241,.12);
}

/* ==================================================
   LIST
================================================== */

.currency-list{
    max-height:260px;
    overflow-y:auto;

    padding-right:4px;
}

.currency-list::-webkit-scrollbar{
    width:8px;
}

.currency-list::-webkit-scrollbar-track{
    background:transparent;
}

.currency-list::-webkit-scrollbar-thumb{
    border-radius:999px;

    background:
        linear-gradient(
            180deg,
            #d9e5f0,
            #89dfff
        );
}

/* ==================================================
   ITEM
================================================== */

.currency-item{
    position:relative;

    padding:14px 14px;

    border-radius:16px;

    cursor:pointer;

    overflow:hidden;

    transition:
        transform .25s cubic-bezier(.22,1,.36,1),
        box-shadow .25s cubic-bezier(.22,1,.36,1),
        background .25s ease;
}

.currency-item::before{
    content:"";

    position:absolute;
    inset:0;

    background:
        linear-gradient(
            120deg,
            transparent,
            rgba(255,255,255,.7),
            transparent
        );

    transform:translateX(-140%);
    transition:transform .55s ease;
}

.currency-item:hover{
    background:
        linear-gradient(
            135deg,
            #f8fdff,
            #e7f8ff
        );

    transform:
        translateX(6px)
        scale(1.015);

    box-shadow:
        0 12px 28px rgba(0,181,241,.10);
}

.currency-item:hover::before{
    transform:translateX(140%);
}

.currency-item.active{
    color:#fff;

    background:
        linear-gradient(
            135deg,
            #009dff,
            #00d4ff,
            #5ce7ff
        );

    background-size:250% 250%;

    animation:
        activeFlow 5s linear infinite;

    box-shadow:
        0 18px 40px rgba(0,181,241,.28),
        0 0 25px rgba(0,212,255,.18);

    font-weight:700;
}

@keyframes activeFlow{
    0%{
        background-position:0% 50%;
    }

    100%{
        background-position:250% 50%;
    }
}
/* =========================================
   CATEGORIES
========================================= */
.categories{

    display:flex;
    flex-wrap:wrap;

    justify-content:center;

    gap:14px;

    padding:16px;
}

.circle{

    width:74px;
    height:74px;

    overflow:hidden;

    border-radius:50%;

    background:#fff;

    box-shadow:
        0 4px 14px rgba(0,0,0,.05);

    transition:
        .18s ease;
}

.category:hover .circle{

    transform:
        scale(1.06);

    box-shadow:
        0 8px 20px rgba(0,0,0,.08);
}

.category.active .circle{

    transform:
        scale(1.06);

    box-shadow:
        0 0 0 3px rgba(0,181,241,.18),
        0 8px 20px rgba(0,181,241,.15);
}

.category.hidden{

    opacity:0;

    transform:
        scale(.85);

    pointer-events:none;

    position:absolute;
}

/* =========================================
   FOOTER
========================================= */
.bottom-footer{

    margin-top:50px;

    padding:16px;

    display:flex;
    justify-content:center;

    gap:20px;

    font-size:12px;
}

.bottom-footer a{

    color:#7a8ca5;

    text-decoration:none;

    transition:.15s ease;
}

.bottom-footer a:hover{
    color:#00b5f1;
}

/* =========================================
   FLOAT BUTTON
========================================= */
#floatingSearchBtn{

    position:fixed;

    bottom:20px;
    right:20px;

    padding:14px 24px;

    border:none;

    border-radius:16px;

    background:
        linear-gradient(
            135deg,
            #00c2ff,
            #00a8f5
        );

    color:white;

    font-size:14px;
    font-weight:700;

    cursor:pointer;

    box-shadow:
        0 10px 30px rgba(0,181,241,.22);

    opacity:0;
    visibility:hidden;

    transform:
        translateY(15px);

    transition:
        .22s ease;
}

#floatingSearchBtn.show{

    opacity:1;
    visibility:visible;

    transform:
        translateY(0);
}

#floatingSearchBtn:hover{

    transform:
        translateY(-2px);

    box-shadow:
        0 14px 35px rgba(0,181,241,.28);
}
/* =========================================
   ANIMATIONS
========================================= */
@keyframes paintBlob{

    0%{
        border-radius:
            52% 48% 58% 42% /
            42% 57% 43% 58%;
    }

    25%{
        border-radius:
            63% 37% 46% 54% /
            54% 42% 58% 46%;
    }

    50%{
        border-radius:
            40% 60% 52% 48% /
            61% 38% 62% 39%;
    }

    75%{
        border-radius:
            57% 43% 63% 37% /
            44% 58% 42% 56%;
    }

    100%{
        border-radius:
            52% 48% 58% 42% /
            42% 57% 43% 58%;
    }
}

@keyframes brushTextFloat{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-2px);
    }
}

@keyframes dropPaint{

    from{
        opacity:0;
        transform:
            translateY(-12px)
            scale(.95);
    }

    to{
        opacity:1;
        transform:
            translateY(0)
            scale(1);
    }
}
