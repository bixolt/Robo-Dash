.price-range {
    position: relative;
    width: 100%;
    padding: 50px 8px 10px;
    box-sizing: border-box;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    background: transparent;
}

.price-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 100px;
}

.price-field label {
    font-size: 12px;
    font-weight: 600;
    color: #6b7280;
    padding-left: 2px;
}

.price-range::before {
    content: "";
    position: absolute;
    left: 8px;
    right: 8px;
    top: 22px;
    height: 2px;
    border-radius: 999px;
    z-index: 1;

    background: linear-gradient(180deg, #effcff 0%, #8eeaff 100%);

    box-shadow:
        inset 0 1px 2px rgba(0,0,0,0.10),
        inset 0 -1px 2px rgba(255,255,255,0.7);
}

.price-range::after {
    content: "";
    position: absolute;
    left: calc(8px + var(--min) - 5px);
    right: calc(100% - var(--max));
    top: 22px;
    height: 2px;
    border-radius: 999px;
    z-index: 2;

    background: linear-gradient(90deg, #8eeaff 0%, #54dbff 50%, #38cfff 100%);

    box-shadow:
        inset 0 1px 1px rgba(255,255,255,0.35),
        inset 0 -1px 2px rgba(0,0,0,0.12),
        0 2px 6px rgba(120,240,255,0.35);
}
/* ================= FLOATING DOT WAVES ================= */

.bar{
    position: absolute;

    /* התחלה */
    left: calc(4px + var(--min) - 1px);
    top: -21px;

    /* סוף */
    right: calc(100% - var(--max));

    height: 150px;

    overflow: hidden;




}
.bar::before{
    content: "";

    position: absolute;

    inset: 0;

    border-radius: inherit;

    pointer-events: none;

    box-shadow:
        inset 0 0 22px rgba(255,255,255,.15),
        0 0 24px rgba(0,180,255,.12);

    z-index: 4;
}

/* =========================================
   INNER
========================================= */
.bar-inner{
    position: absolute;
    inset: 0;
    top:-5px ;
    overflow: hidden;
    pointer-events: none;

    z-index: 2;

    border-radius: inherit;

    height: 50px;
}

/* =========================================
   WAVE
========================================= */
.wave{
    position:absolute;

    left:0;
    top:20px;

    width:100%;
    height:36px;

    transform:translateY(-50%);
    transform-origin:center center;

    overflow:hidden;

    pointer-events:none;
    isolation:isolate;

    opacity:.98;

    will-change:
        transform,
        filter,
        clip-path;

    filter:
        blur(.12px)
        saturate(1.35)
        brightness(1.04);

    clip-path:
        polygon(
            0% 58%,
            4% 52%,
            8% 64%,
            12% 48%,
            16% 61%,
            20% 45%,
            24% 66%,
            28% 54%,
            32% 62%,
            36% 46%,
            40% 57%,
            44% 51%,
            48% 68%,
            52% 48%,
            56% 60%,
            60% 45%,
            64% 67%,
            68% 54%,
            72% 62%,
            76% 47%,
            80% 58%,
            84% 52%,
            88% 66%,
            92% 54%,
            96% 61%,
            100% 50%,
            100% 100%,
            0% 100%
        );

    animation:
        googleSurface 5s ease-in-out infinite;
}

/* =========================================
   MAIN GOOGLE LIQUID
========================================= */
.wave::before{
    content:"";

    position:absolute;
    inset:-25%;

    background:
        linear-gradient(
            90deg,

            #4285F4 0%,
            #6EA8FF 8%,
            #8FC2FF 14%,

            #34A853 24%,
            #7BDC6B 33%,

            #FBBC05 46%,
            #FFE27A 56%,

            #EA4335 68%,
            #FF9B91 78%,

            #4285F4 90%,
            #8FC2FF 100%
        );

    background-size:400% 100%;

    filter:
        blur(.2px)
        saturate(1.3);

    box-shadow:
        0 0 10px rgba(66,133,244,.20),
        0 0 20px rgba(66,133,244,.18),
        0 0 35px rgba(52,168,83,.16),
        0 0 55px rgba(251,188,5,.14),
        0 0 85px rgba(234,67,53,.10),

        inset 0 2px 5px rgba(255,255,255,.35),
        inset 0 -4px 10px rgba(66,133,244,.12);

    animation:
        googleFlow 4s linear infinite,
        googleBreath 3.5s ease-in-out infinite;
}

/* =========================================
   PREMIUM GLASS SHINE
========================================= */
.wave::after{
    content:"";

    position:absolute;
    inset:0;

    background:

        radial-gradient(
            circle at 8% 35%,
            rgba(255,255,255,.95),
            transparent 10%
        ),

        radial-gradient(
            circle at 28% 45%,
            rgba(255,255,255,.55),
            transparent 18%
        ),

        radial-gradient(
            circle at 52% 40%,
            rgba(255,255,255,.45),
            transparent 22%
        ),

        radial-gradient(
            circle at 75% 42%,
            rgba(255,255,255,.55),
            transparent 18%
        ),

        radial-gradient(
            circle at 92% 35%,
            rgba(255,255,255,.95),
            transparent 10%
        ),

        linear-gradient(
            180deg,
            rgba(255,255,255,.42),
            transparent 35%
        ),

        linear-gradient(
            90deg,
            rgba(255,255,255,.95),
            rgba(255,255,255,.08),
            rgba(255,255,255,.95)
        );

    mix-blend-mode:screen;

    animation:
        googleShimmer 2.5s linear infinite,
        googleGlow 3s ease-in-out infinite;
}

/* =========================================
   COLOR FLOW
========================================= */
@keyframes googleFlow{

    0%{
        background-position:0% 0%;
    }

    100%{
        background-position:400% 0%;
    }
}

/* =========================================
   LIQUID SURFACE
========================================= */
@keyframes googleSurface{

    0%{
        clip-path:
            polygon(
                0% 56%,
                8% 64%,
                16% 53%,
                24% 67%,
                32% 47%,
                40% 58%,
                48% 66%,
                56% 53%,
                64% 64%,
                72% 49%,
                80% 59%,
                88% 65%,
                100% 54%,
                100% 100%,
                0% 100%
            );
    }

    25%{
        clip-path:
            polygon(
                0% 51%,
                8% 61%,
                16% 46%,
                24% 64%,
                32% 52%,
                40% 68%,
                48% 54%,
                56% 63%,
                64% 47%,
                72% 58%,
                80% 50%,
                88% 67%,
                100% 57%,
                100% 100%,
                0% 100%
            );
    }

    50%{
        clip-path:
            polygon(
                0% 63%,
                8% 49%,
                16% 66%,
                24% 52%,
                32% 61%,
                40% 45%,
                48% 68%,
                56% 51%,
                64% 63%,
                72% 47%,
                80% 65%,
                88% 53%,
                100% 60%,
                100% 100%,
                0% 100%
            );
    }

    75%{
        clip-path:
            polygon(
                0% 54%,
                8% 66%,
                16% 50%,
                24% 61%,
                32% 44%,
                40% 65%,
                48% 53%,
                56% 64%,
                64% 48%,
                72% 57%,
                80% 50%,
                88% 66%,
                100% 55%,
                100% 100%,
                0% 100%
            );
    }

    100%{
        clip-path:
            polygon(
                0% 56%,
                8% 64%,
                16% 53%,
                24% 67%,
                32% 47%,
                40% 58%,
                48% 66%,
                56% 53%,
                64% 64%,
                72% 49%,
                80% 59%,
                88% 65%,
                100% 54%,
                100% 100%,
                0% 100%
            );
    }
}

/* =========================================
   SOFT GOOGLE BREATH
========================================= */
@keyframes googleBreath{

    0%{
        transform:
            scaleY(.93)
            scaleX(1);
    }

    50%{
        transform:
            scaleY(1.10)
            scaleX(1.015);
    }

    100%{
        transform:
            scaleY(.93)
            scaleX(1);
    }
}

/* =========================================
   LIGHT SWEEP
========================================= */
@keyframes googleShimmer{

    0%{
        transform:
            translateX(-100px);
    }

    100%{
        transform:
            translateX(100px);
    }
}

/* =========================================
   PREMIUM GLOW
========================================= */
@keyframes googleGlow{

    0%{
        opacity:.65;
        filter:blur(0px);
    }

    50%{
        opacity:1;
        filter:blur(.25px);
    }

    100%{
        opacity:.65;
        filter:blur(0px);
    }
}
.min-slider,
.max-slider{
    width:100%;
    position:absolute;
    left:0;
    top:-18px;
