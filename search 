    appearance:none;
    background:transparent;
    z-index:30;
}

/* ==================================================
   MINIMAL GOOGLE / APPLE STYLE
   ================================================== */

.min-slider::-webkit-slider-thumb,
.max-slider::-webkit-slider-thumb{

    pointer-events:all;

    -webkit-appearance:none;
    appearance:none;

    width:8px;
    height:88px;

    cursor:pointer;
    border:none;

    border-radius:999px;

