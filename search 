/* =========================================
   CREATE LAYER
========================================= */
function createWaveLayer(
    phase,
    amplitudeMultiplier,
    opacity,
    index
){

    const svg =
        document.createElementNS(
            "http://www.w3.org/2000/svg",
            "svg"
        );

    svg.setAttribute(
        "viewBox",
        `0 0 ${WAVE_WIDTH} 320`
    );

    svg.setAttribute(
        "preserveAspectRatio",
        "none"
    );

    svg.style.position =
        "absolute";

    svg.style.left =
        "0";

    svg.style.top =
        "70%";

    svg.style.width =
        "220%";

    svg.style.height =
        "180%";

    svg.style.pointerEvents =
        "none";

    svg.style.opacity =
        opacity;

    svg.style.mixBlendMode =
        "screen";

    const defs =
        document.createElementNS(
            "http://www.w3.org/2000/svg",
            "defs"
        );

    const gradient =
        document.createElementNS(
            "http://www.w3.org/2000/svg",
            "linearGradient"
        );

    const gradientId =
        `waveGradient_${index}_${Math.random()}`;

    gradient.setAttribute(
        "id",
        gradientId
    );

    gradient.setAttribute(
        "gradientUnits",
        "userSpaceOnUse"
    );

    gradient.setAttribute(
        "x1",
        "0"
    );

    gradient.setAttribute(
        "x2",
        WAVE_WIDTH
    );

    gradient.setAttribute(
        "y1",
        "0"
    );

    gradient.setAttribute(
        "y2",
        "0"
    );

const colors = [
    "rgba(102,157,246,0.65)", // soft blue
    "rgba(91,185,116,0.65)",  // soft green
    "rgba(253,214,99,0.65)",  // soft yellow
    "rgba(242,139,130,0.65)", // soft red

    "rgba(138,180,248,0.65)",
    "rgba(129,201,133,0.65)",
    "rgba(252,232,178,0.65)",
    "rgba(246,174,169,0.65)",

    "rgba(174,203,250,0.6)",
    "rgba(183,225,205,0.6)",
    "rgba(255,241,194,0.6)",
    "rgba(250,217,213,0.6)"
];
    colors.forEach(
        (color,index)=>{

            const stop =
                document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "stop"
                );

            stop.setAttribute(
                "offset",
                `${(index/(colors.length-1))*100}%`
            );

            stop.setAttribute(
                "stop-color",
                color
            );

            gradient.appendChild(
                stop
            );
        }
    );

    defs.appendChild(
        gradient
    );

    const path =
        document.createElementNS(
            "http://www.w3.org/2000/svg",
            "path"
        );

    path.setAttribute(
        "fill",
        `url(#${gradientId})`
    );

    svg.appendChild(defs);
    svg.appendChild(path);

    barInner.appendChild(svg);

    waves.push({
        svg,
        path,
        gradient,
        phase,
        amplitudeMultiplier
    });
}

/* =========================================
   ADVANCED FLUID SURFACE
========================================= */
function buildWavePath(
    time,
    amplitudeMultiplier
){

    const width =
        WAVE_WIDTH;

    const height =
        280;

    const centerY =

        200 +

        Math.sin(
            time * 0.15
        ) * 10 +

        Math.cos(
            time * 0.07
        ) * 5;

    const points = [];

    for(
        let x = 0;
        x <= width;
        x += 16
    ){

        const giantSwell =

            Math.sin(
                x * 0.0014 +
                time * 0.55
            ) *

            60 *

            amplitudeMultiplier;

        const secondarySwell =

            Math.cos(
                x * 0.0028 -
                time * 0.90
            ) *

            35 *

            amplitudeMultiplier;

        const tertiary =

            Math.sin(
                x * 0.0055 +
                time * 1.60
            ) *

            20 *

            amplitudeMultiplier;

        const rippleA =

            Math.sin(
                x * 0.016 +
                time * 3.2
            ) *

            6 *

            amplitudeMultiplier;

        const rippleB =

            Math.cos(
                x * 0.028 -
                time * 2.7
            ) *

            4 *

            amplitudeMultiplier;

        const rippleC =

            Math.sin(
                x * 0.045 +
                time * 4.5
            ) *

            2 *

            amplitudeMultiplier;

        const breathing =

            Math.sin(
                time * 0.28
            ) *

            12 *

            amplitudeMultiplier;

        const y =

            centerY +
            giantSwell +
            secondarySwell +
            tertiary +
            rippleA +
            rippleB +
            rippleC +
            breathing;

        points.push({
            x,
            y
        });
    }

    let d =
        `M 0 ${height}`;

    d +=
        ` L ${points[0].x} ${points[0].y}`;

    for(
        let i = 0;
        i < points.length - 1;
        i++
    ){

        const current =
            points[i];

        const next =
            points[i + 1];

        const xc =
            (current.x + next.x) / 2;

        const yc =
            (current.y + next.y) / 2;

        d +=
            ` Q ${current.x} ${current.y} ${xc} ${yc}`;
    }

    const last =
        points[
            points.length - 1
        ];

    d +=
        ` L ${last.x} ${last.y}`;

    d +=
        ` L ${width} ${height}`;

    d +=
        ` L 0 ${height} Z`;

    return d;
}

/* =========================================
   ANIMATION
========================================= */
function animateWaves(){


    noiseOffset += 0.07;

    waves.forEach(
        wave=>{

            const time =
                noiseOffset +
                wave.phase;

            const floatY =

                Math.sin(
                    time * 0.35
                ) * 8 +

                Math.cos(
                    time * 0.18
                ) * 4;

            const scaleY =

                1 +

                Math.sin(
                    time * 0.14
                ) *

                0.045;

            const scaleX =

                1 +

                Math.cos(
                    time * 0.08
                ) *

                0.015;

            const skew =

                Math.sin(
                    time * 0.10
                ) *

                1.2;

            wave.svg.style.transform =
                `
                translateY(calc(-50% + ${floatY}px))
                scaleX(${scaleX})
                scaleY(${scaleY})
                skewX(${skew}deg)
                `;

            wave.path.setAttribute(
                "d",
                buildWavePath(
                    time,
                    wave.amplitudeMultiplier
                )
            );

            const gradientShift =

                (
                    Math.sin(
                        time * 0.22
                    ) + 1
                ) *

                400;

            wave.gradient.setAttribute(
                "x1",
                -gradientShift
            );

            wave.gradient.setAttribute(
                "x2",
                WAVE_WIDTH -
                gradientShift
            );

            const blur =

                1 +
                (
                    1 -
                    wave.amplitudeMultiplier
                ) *
                6;

            const glow =

                20 *
                wave.amplitudeMultiplier;


        }
    );

    animationId =
        requestAnimationFrame(
            animateWaves
        );
}

/* =========================================
   CLEAR
========================================= */
function clearWaves(){

    cancelAnimationFrame(
        animationId
    );

    waves = [];

    barInner.innerHTML = "";
}

