/* ================= BODY ================= */
body {
    margin: 0;
    font-family: 'Inter', Arial, sans-serif;
    color: #1f2937;

    background: linear-gradient(
        180deg,
        #f7f9fc 0%,
        #eef2f7 55%,
        #e6edf6 100%
    );

    background-attachment: fixed;
}

/* סיסטם חלק */
* {
    -webkit-tap-highlight-color: transparent;
    box-sizing: border-box;
}

/* ================= NAVBAR ================= */
.top-navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 14px 24px;

    background: rgba(255,255,255,0.55);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);

    border-bottom: 1px solid rgba(0,0,0,0.05);

    box-shadow:
        0 10px 35px rgba(0,0,0,0.07),
        0 1px 0 rgba(255,255,255,0.7) inset;

    transition: transform 0.25s ease, opacity 0.25s ease;
}

.top-navbar.scrolled {
    transform: translateY(-110%);
    opacity: 0;
    pointer-events: none;
}

.top-navbar::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        90deg,
        rgba(0,114,255,0.06),
        rgba(0,198,255,0.04),
        transparent
    );
    pointer-events: none;
}

.top-navbar .logo {
    font-weight: 800;
    font-size: 15px;

    background: linear-gradient(90deg, #0072ff, #00c6ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    letter-spacing: 0.5px;
}

/* ================= NAV LINKS ================= */
.nav-links {
    display: flex;
    gap: 20px;
    align-items: center;
}

.nav-links a {
    font-size: 13px;
    color: #6b7280;
    text-decoration: none;

    position: relative;
    padding: 6px 4px;

    transition: all 0.25s ease;
}

.nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;

    width: 0%;
    height: 2px;
    border-radius: 999px;

    background: linear-gradient(90deg, #0072ff, #00c6ff);

    transition: width 0.3s ease;
}

.nav-links a:hover {
    color: #0072ff;
    transform: translateY(-1px);
}

.nav-links a:hover::after {
    width: 100%;
}

/* אפקט עדין של עומק בלינקים */
.nav-links a:active {
    transform: scale(0.96);
}

/* ================= TITLE ================= */
.search-label{
    position:;

    display:flex;
    justify-content:center;
    align-items:center;

    margin-top:55px;
    margin-bottom:35px;

    font-size:clamp(28px,4vw,48px);
    font-weight:200;

    letter-spacing:-1.2px;
    line-height:1.05;

    text-align:center;

    background:
        linear-gradient(
            90deg,
            #4285F4 0%,
            #6FAEFF 12%,
            #34A853 28%,
            #86E56F 42%,
            #FBBC05 58%,
            #FFE27A 70%,
            #EA4335 86%,
            #FF8F84 100%
        );

    background-size:300% 100%;

    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;

    filter:
        drop-shadow(0 0 12px rgba(66,133,244,.18))
        drop-shadow(0 0 20px rgba(52,168,83,.10));

    animation:
        googleTextFlow 10s linear infinite,
        googleFloat 6s ease-in-out infinite;
}

/* glass aura */
.search-label::before{
    content:"";

    position:absolute;

    width:80%;
    height:220%;

    left:50%;
    top:50%;

    transform:
        translate(-50%,-50%);

    border-radius:999px;

    background:
        radial-gradient(
            circle,
            rgba(66,133,244,.12),
            rgba(52,168,83,.08),
            rgba(251,188,5,.06),
            transparent 70%
        );

    filter:blur(45px);

    z-index:-2;

    animation:
        googleAura 8s ease-in-out infinite;
}

/* premium animated underline */
.search-label::after{
    content:"";

    position:absolute;

    left:50%;
    bottom:-16px;

    transform:
        translateX(-50%);

    width:180px;
    height:4px;

    border-radius:999px;

    background:
        linear-gradient(
            90deg,
            #4285F4,
            #34A853,
            #FBBC05,
            #EA4335,
            #4285F4
        );

    background-size:300% 100%;

    box-shadow:
        0 0 10px rgba(66,133,244,.25),
        0 0 20px rgba(52,168,83,.18),
        0 0 30px rgba(234,67,53,.12);

    animation:
        googleLineFlow 4s linear infinite;
}

/* top sparkle */
.search-label span{
    position:relative;
}

.search-label span::before{
    content:"✦";

    position:absolute;

    top:-18px;
    right:-22px;

    font-size:14px;

    background:
        linear-gradient(
            135deg,
            #4285F4,
            #34A853,
            #FBBC05,
            #EA4335
        );

    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;

    animation:
        sparklePulse 2.5s ease-in-out infinite;
}

@keyframes googleTextFlow{

    0%{
        background-position:0% 50%;
    }

    100%{
        background-position:300% 50%;
    }
}

@keyframes googleLineFlow{

    0%{
        background-position:0% 50%;
    }

    100%{
        background-position:300% 50%;
    }
}

@keyframes googleFloat{

    0%{
        transform:translateY(0px);
    }

    50%{
        transform:translateY(-2px);
    }

    100%{
        transform:translateY(0px);
    }
}

@keyframes googleAura{

    0%{
        opacity:.65;
        transform:
            translate(-50%,-50%)
            scale(1);
    }

    50%{
        opacity:1;
        transform:
            translate(-50%,-50%)
            scale(1.08);
    }

    100%{
        opacity:.65;
        transform:
            translate(-50%,-50%)
            scale(1);
    }
}

@keyframes sparklePulse{

    0%{
        opacity:.4;
        transform:
            scale(.8)
            rotate(0deg);
    }

    50%{
        opacity:1;
        transform:
            scale(1.25)
            rotate(25deg);
    }

    100%{
        opacity:.4;
        transform:
            scale(.8)
            rotate(0deg);
    }
}

/* ================= SEARCH ================= */
/* =========================================================
   APPLE / OPENAI LEVEL PREMIUM TEXTAREA
========================================================= */

@property --angle{
    syntax:"<angle>";
    inherits:false;
    initial-value:0deg;
}

@property --x{
    syntax:"<percentage>";
    inherits:false;
    initial-value:20%;
}

@property --y{
    syntax:"<percentage>";
    inherits:false;
    initial-value:30%;
}

@property --x2{
    syntax:"<percentage>";
    inherits:false;
    initial-value:80%;
}

@property --y2{
    syntax:"<percentage>";
    inherits:false;
    initial-value:70%;
}

/* =========================================================
   CONTAINER
========================================================= */

.describe-box{
    display:flex;
    justify-content:center;
    margin:42px 15px;
    position:relative;
}

/* =========================================================
   TEXTAREA
========================================================= */

.describe-box textarea{
    width:92vw;
    max-width:760px;
    min-height:130px;

    padding:22px 24px;

    border:2px solid transparent;
    border-radius:30px;

    outline:none;
    resize:none;

    color:#111827;
    font-size:15px;
    line-height:1.7;
    font-weight:200;

    position:relative;

    background:

        radial-gradient(
            circle at var(--x) var(--y),
            rgba(66,133,244,.18),
            transparent 22%
        ),

        radial-gradient(
            circle at var(--x2) var(--y2),
            rgba(52,168,83,.14),
            transparent 24%
        ),

        radial-gradient(
            circle at 80% 18%,
            rgba(251,188,5,.12),
            transparent 18%
        ),

        radial-gradient(
            circle at 20% 85%,
            rgba(234,67,53,.10),
            transparent 20%
        ),

        linear-gradient(
            rgba(255,255,255,.90),
            rgba(255,255,255,.88)
        ) padding-box,

        conic-gradient(
            from var(--angle),
            #4285f4,
            #64a3ff,
            #34a853,
            #72db78,
            #fbbc05,
            #ffe08a,
            #ea4335,
            #ff8d86,
            #4285f4
        ) border-box;

    backdrop-filter:blur(24px) saturate(170%);
    -webkit-backdrop-filter:blur(24px) saturate(170%);

    box-shadow:
        0 30px 80px rgba(15,23,42,.10),
        0 15px 35px rgba(15,23,42,.06),
        inset 0 1px 0 rgba(255,255,255,.95),
        inset 0 -1px 0 rgba(255,255,255,.40),
        0 0 0 1px rgba(255,255,255,.65);

    animation:
        borderSpin 10s linear infinite,
        liquidMove 18s ease-in-out infinite,
        breathingGlow 6s ease-in-out infinite;

    transition:
        transform .45s cubic-bezier(.22,1,.36,1),
        box-shadow .45s cubic-bezier(.22,1,.36,1),
        background .45s ease;
}

/* =========================================================
   PLACEHOLDER
========================================================= */

.describe-box textarea::placeholder{
    color:rgba(55,65,81,.55);
    font-family:
    "Satoshi",
    "Manrope",
    "Inter",
    "SF Pro Display",
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;
    font-size: 17px;
    font-weight:300;
    letter-spacing:.2px;
}

/* =========================================================
   HOVER
========================================================= */

.describe-box textarea:hover{

    transform:
        translateY(-3px);

    box-shadow:
        0 40px 90px rgba(66,133,244,.12),
        0 18px 40px rgba(15,23,42,.08),
        inset 0 1px 0 rgba(255,255,255,.95),
        0 0 40px rgba(66,133,244,.08);
}

/* =========================================================
   FOCUS
========================================================= */

.describe-box textarea:focus{

    transform:
        translateY(-5px)
        scale(1.01);

    background:

        radial-gradient(
            circle at var(--x) var(--y),
            rgba(66,133,244,.24),
            transparent 25%
        ),

        radial-gradient(
            circle at var(--x2) var(--y2),
            rgba(52,168,83,.18),
            transparent 26%
        ),

        radial-gradient(
            circle at 80% 18%,
            rgba(251,188,5,.18),
            transparent 18%
        ),

        radial-gradient(
            circle at 20% 85%,
            rgba(234,67,53,.15),
            transparent 20%
        ),

        linear-gradient(
            rgba(255,255,255,.96),
            rgba(255,255,255,.92)
        ) padding-box,

        conic-gradient(
            from var(--angle),
            #4285f4,
            #6fb3ff,
            #34a853,
            #8df18d,
            #fbbc05,
            #ffe27c,
            #ea4335,
            #ff9f95,
            #4285f4
        ) border-box;

    box-shadow:
        0 50px 120px rgba(66,133,244,.18),
        0 25px 55px rgba(15,23,42,.12),
        0 0 0 5px rgba(66,133,244,.08),
        0 0 40px rgba(66,133,244,.15),
        0 0 60px rgba(52,168,83,.10),
        inset 0 1px 0 rgba(255,255,255,.95);

    animation:
        borderSpin 4s linear infinite,
        liquidMove 10s ease-in-out infinite,
        breathingGlow 2.5s ease-in-out infinite;
}

/* =========================================================
   SCROLLBAR
========================================================= */

/* =========================================================
   SOFT MINIMAL SCROLLBAR (TEXTAREA)
========================================================= */


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes borderSpin{

    from{
        --angle:0deg;
    }

    to{
        --angle:360deg;
    }
}

@keyframes breathingGlow{

    0%{
        filter:
            brightness(1)
            saturate(1);
    }

    50%{
        filter:
            brightness(1.08)
            saturate(1.15);
    }

    100%{
        filter:
            brightness(1)
            saturate(1);
    }
}

@keyframes liquidMove{

    0%{
        --x:18%;
        --y:25%;

        --x2:82%;
        --y2:70%;
    }

    25%{
        --x:75%;
        --y:18%;

        --x2:28%;
        --y2:80%;
    }

    50%{
        --x:88%;
        --y:70%;

        --x2:18%;
        --y2:30%;
    }

    75%{
        --x:35%;
        --y:88%;

        --x2:82%;
        --y2:22%;
    }

    100%{
        --x:18%;
        --y:25%;

        --x2:82%;
        --y2:70%;
    }
}

/* =========================================================
   ANIMATIONS
========================================================= */

/* =========================================================
   APPLE-INSPIRED PREMIUM DROPDOWN
   Ultra Modern • Liquid Gold • Glass Morphism
========================================================= */

@property --x1{
    syntax:"<percentage>";
    inherits:false;
    initial-value:20%;
}
@property --y1{
    syntax:"<percentage>";
    inherits:false;
    initial-value:30%;
}
@property --x2{
    syntax:"<percentage>";
    inherits:false;
    initial-value:80%;
}
@property --y2{
    syntax:"<percentage>";
    inherits:false;
    initial-value:70%;
}
@property --rotate{
    syntax:"<angle>";
    inherits:false;
    initial-value:0deg;
}

*{
    box-sizing:border-box;
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes liquidFlow{

    0%{
        --x1:18%;
        --y1:30%;
        --x2:82%;
        --y2:72%;
    }

    25%{
        --x1:72%;
        --y1:18%;
        --x2:25%;
        --y2:82%;
    }

    50%{
        --x1:88%;
        --y1:72%;
        --x2:18%;
        --y2:28%;
    }

    75%{
        --x1:35%;
        --y1:88%;
        --x2:82%;
        --y2:15%;
    }

    100%{
        --x1:18%;
        --y1:30%;
        --x2:82%;
        --y2:72%;
    }
}

@keyframes rotateGlow{
    from{
        --rotate:0deg;
    }
    to{
        --rotate:360deg;
    }
}

@keyframes reveal{
    from{
        opacity:0;
        transform:translateY(25px) scale(.96);
        filter:blur(15px);
    }
    to{
        opacity:1;
        transform:none;
        filter:none;
    }
}

@keyframes pulse{
    0%,100%{
        transform:translateY(-50%) scale(1);
    }
    50%{
        transform:translateY(-50%) scale(1.08);
    }
}

/* =========================================================
   DROPDOWN
========================================================= */

.dropdown{
    width:60%;
    max-width:650px;

    position:relative;

    margin:0 auto;   /* זה מה שחסר לך */

    animation:reveal .9s cubic-bezier(.22,1,.36,1);
}

/* =========================================================
   SEARCH BOX
========================================================= */

.search-box{
    position:relative;
    overflow:hidden;
    border-radius:34px;
}

/* Liquid Background */

.search-box::before{
    content:"";
    position:absolute;
    inset:0;

    background:

    radial-gradient(
        circle at var(--x1) var(--y1),
        rgba(255,198,82,.75),
        transparent 22%
    ),

    radial-gradient(
        circle at var(--x2) var(--y2),
        rgba(255,226,165,.85),
        transparent 24%
    ),

    radial-gradient(
        circle at 50% 50%,
        rgba(255,255,255,.85),
        transparent 70%
    ),

    linear-gradient(
        135deg,
        rgba(255,255,255,.96),
        rgba(248,248,250,.96)
    );

    animation:
    liquidFlow 14s ease-in-out infinite;

    z-index:0;
}

/* Premium Border */

.search-box::after{
    content:"";
    position:absolute;
    inset:-1px;
    border-radius:35px;

    background:
    conic-gradient(
        from var(--rotate),
        rgba(255,212,122,.8),
        rgba(255,255,255,.8),
        rgba(255,184,77,.8),
        rgba(255,255,255,.8),
        rgba(255,212,122,.8)
    );

    animation:
    rotateGlow 12s linear infinite;

    z-index:-1;

    filter:
    blur(14px);

    opacity:.85;
}

/* =========================================================
   INPUT
========================================================= */

.dropdown-search{

    position:relative;
    z-index:2;

    width:100%;

    padding:
    22px
    65px
    22px
    28px;

    border:none;
    outline:none;

    border-radius:34px;

    font-size:15px;
    font-weight:200;
    letter-spacing:.3px;

    color:#222;

    backdrop-filter:
    blur(18px);

    background:
    rgba(255,255,255,.45);

    box-shadow:

    inset 0 1px 0 rgba(255,255,255,.9),

    inset 0 -1px 0 rgba(255,255,255,.5),

    0 20px 40px rgba(0,0,0,.08),

    0 5px 15px rgba(0,0,0,.04);

    transition:
    .45s cubic-bezier(.22,1,.36,1);
}

.dropdown-search::placeholder{
    color:#9d9d9d;
}

.dropdown-search:focus{

    transform:
    translateY(-2px);

    box-shadow:

    inset 0 1px 0 rgba(255,255,255,1),

    0 28px 60px rgba(255,191,73,.18),

    0 8px 25px rgba(0,0,0,.08);
}

/* =========================================================
   CLEAR BUTTON
========================================================= */

.clear-btn{

    position:absolute;

    right:14px;
    top:50%;

    transform:
    translateY(-50%);

    width:42px;
    height:42px;

    border-radius:50%;

    display:flex;
    align-items:center;
    justify-content:center;

    z-index:3;

    cursor:pointer;

    font-size:24px;
    font-weight:300;

    color:#8b6a2f;

    background:
    linear-gradient(
        145deg,
        rgba(255,255,255,.95),
        rgba(248,245,236,.95)
    );

    backdrop-filter:
    blur(20px);

    box-shadow:

    inset 0 1px 0 rgba(255,255,255,.95),

    0 8px 20px rgba(0,0,0,.08),

