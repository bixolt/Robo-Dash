/* =========================================
   FLOAT BUTTON
========================================= */
#floatingSearchBtn{

    position:fixed;

    bottom:20px;
    right:20px;

    padding:14px 24px;

    border:none;

    border-radius:16px;

    background:
        linear-gradient(
            135deg,
            #00c2ff,
            #00a8f5
        );

    color:white;

    font-size:14px;
    font-weight:700;

    cursor:pointer;

    box-shadow:
        0 10px 30px rgba(0,181,241,.22);

    opacity:0;
    visibility:hidden;

    transform:
        translateY(15px);

    transition:
        .22s ease;
}

#floatingSearchBtn.show{

    opacity:1;
    visibility:visible;

    transform:
        translateY(0);
}

#floatingSearchBtn:hover{

    transform:
        translateY(-2px);

    box-shadow:
        0 14px 35px rgba(0,181,241,.28);
}
/* =========================================
   ANIMATIONS
========================================= */
@keyframes paintBlob{

    0%{
        border-radius:
            52% 48% 58% 42% /
            42% 57% 43% 58%;
    }

    25%{
        border-radius:
            63% 37% 46% 54% /
            54% 42% 58% 46%;
    }

    50%{
        border-radius:
            40% 60% 52% 48% /
            61% 38% 62% 39%;
    }

    75%{
        border-radius:
            57% 43% 63% 37% /
            44% 58% 42% 56%;
    }

    100%{
        border-radius:
            52% 48% 58% 42% /
            42% 57% 43% 58%;
    }
}

@keyframes brushTextFloat{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-2px);
    }
}

@keyframes dropPaint{

    from{
        opacity:0;
        transform:
            translateY(-12px)
            scale(.95);
    }

    to{
        opacity:1;
        transform:
            translateY(0)
            scale(1);
    }
}


