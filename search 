/* ================= BODY ================= */
body{
    margin:0;
    min-height:100vh;

    font-family:
        Inter,
        "SF Pro Display",
        Arial,
        sans-serif;

    color:#1f2937;

    background:
        radial-gradient(
            circle at 12% 18%,
            rgba(255,215,0,.35),
            transparent 30%
        ),

        radial-gradient(
            circle at 88% 15%,
            rgba(255,230,160,.22),
            transparent 28%
        ),

        radial-gradient(
            circle at 22% 82%,
            rgba(255,193,7,.18),
            transparent 36%
        ),

        radial-gradient(
            circle at 82% 78%,
            rgba(66,133,244,.15),
            transparent 38%
        ),

        radial-gradient(
            circle at 55% 35%,
            rgba(120,190,255,.08),
            transparent 42%
        ),

        linear-gradient(
            135deg,
            #ffffff 0%,
            #fffdf8 20%,
            #faf7ef 45%,
            #f7f9fc 75%,
            #eef4fb 100%
        );

    background-attachment:fixed;
}

/* ================= NAVBAR ================= */
.top-navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 14px 24px;

    background: rgba(255,255,255,0.55);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);

    border-bottom: 1px solid rgba(0,0,0,0.05);

    box-shadow:
        0 10px 35px rgba(0,0,0,0.07),
        0 1px 0 rgba(255,255,255,0.7) inset;

    transition: transform 0.25s ease, opacity 0.25s ease;
}

.top-navbar.scrolled {
    transform: translateY(-110%);
    opacity: 0;
    pointer-events: none;
}

.top-navbar::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        90deg,
        rgba(0,114,255,0.06),
        rgba(0,198,255,0.04),
        transparent
    );
    pointer-events: none;
}

.top-navbar .logo {
    font-weight: 800;
    font-size: 15px;

    background: linear-gradient(90deg, #0072ff, #00c6ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    letter-spacing: 0.5px;
}

/* ================= NAV LINKS ================= */
.nav-links {
    display: flex;
    gap: 20px;
    align-items: center;
}

.nav-links a {
    font-size: 13px;
    color: #6b7280;
    text-decoration: none;

    position: relative;
    padding: 6px 4px;

    transition: all 0.25s ease;
}

.nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;

    width: 0%;
    height: 2px;
    border-radius: 999px;

    background: linear-gradient(90deg, #0072ff, #00c6ff);

    transition: width 0.3s ease;
}

.nav-links a:hover {
    color: #0072ff;
    transform: translateY(-1px);
}

.nav-links a:hover::after {
    width: 100%;
}

/* אפקט עדין של עומק בלינקים */
.nav-links a:active {
    transform: scale(0.96);
}

/* ================= TITLE ================= */
.search-label{
    position:;

    display:flex;
    justify-content:center;
    align-items:center;

    margin-top:55px;
    margin-bottom:35px;

    font-size:clamp(28px,4vw,48px);
    font-weight:200;

    letter-spacing:-1.2px;
    line-height:1.05;

    text-align:center;

    background:
    linear-gradient(
        90deg,
        #4285F4 0%,
        #5A9BFF 18%,
        #34A853 38%,
        #2E7D32 52%,
        #C97A1C 70%,
        #B45309 82%,
        #B23A2F 92%,
        #7A1F1A 100%
    );

    background-size:300% 100%;

    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;

    filter:
        drop-shadow(0 0 12px rgba(66,133,244,.18))
        drop-shadow(0 0 20px rgba(52,168,83,.10));

    animation:
        googleTextFlow 10s linear infinite,
        googleFloat 6s ease-in-out infinite;
}

/* glass aura */
.search-label::before{
    content:"";

    position:absolute;

    width:80%;
    height:220%;

    left:50%;
    top:50%;

    transform:
        translate(-50%,-50%);

    border-radius:999px;

    background:
        radial-gradient(
            circle,
            rgba(66,133,244,.12),
            rgba(52,168,83,.08),
            rgba(251,188,5,.06),
            transparent 70%
        );

    filter:blur(45px);

    z-index:-2;

    animation:
        googleAura 8s ease-in-out infinite;
}

/* premium animated underline */
.search-label::after{
    content:"";

    position:absolute;

    left:50%;
    bottom:-16px;

    transform:
        translateX(-50%);

    width:180px;
    height:4px;

    border-radius:999px;

    background:
        linear-gradient(
            90deg,
            #4285F4,
            #34A853,
            #FBBC05,
            #EA4335,
            #4285F4
        );

    background-size:300% 100%;

    box-shadow:
        0 0 10px rgba(66,133,244,.25),
        0 0 20px rgba(52,168,83,.18),
        0 0 30px rgba(234,67,53,.12);

    animation:
        googleLineFlow 4s linear infinite;
}

/* top sparkle */
.search-label span{
    position:relative;
}

.search-label span::before{
    content:"✦";

    position:absolute;

    top:-18px;
    right:-22px;

    font-size:14px;

    background:
        linear-gradient(
            135deg,
            #4285F4,
            #34A853,
            #FBBC05,
            #EA4335
        );

    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;

    animation:
        sparklePulse 2.5s ease-in-out infinite;
}

@keyframes googleTextFlow{

    0%{
        background-position:0% 50%;
    }

    100%{
        background-position:300% 50%;
    }
}

@keyframes googleLineFlow{

    0%{
        background-position:0% 50%;
    }

    100%{
        background-position:300% 50%;
    }
}

@keyframes googleFloat{

    0%{
        transform:translateY(0px);
    }

    50%{
        transform:translateY(-2px);
    }

    100%{
        transform:translateY(0px);
    }
}

@keyframes googleAura{

    0%{
        opacity:.65;
        transform:
            translate(-50%,-50%)
            scale(1);
    }

    50%{
        opacity:1;
        transform:
            translate(-50%,-50%)
            scale(1.08);
    }

    100%{
        opacity:.65;
        transform:
            translate(-50%,-50%)
            scale(1);
    }
}

@keyframes sparklePulse{

    0%{
        opacity:.4;
        transform:
            scale(.8)
            rotate(0deg);
    }

    50%{
        opacity:1;
        transform:
            scale(1.25)
            rotate(25deg);
    }

    100%{
        opacity:.4;
        transform:
            scale(.8)
            rotate(0deg);
    }
}

/* ================= SEARCH ================= */
/* =========================================================
   APPLE / OPENAI LEVEL PREMIUM TEXTAREA
========================================================= */
@property --angle{
    syntax:"<angle>";
    inherits:false;
    initial-value:0deg;
}

@property --x{
    syntax:"<percentage>";
    inherits:false;
    initial-value:20%;
}

@property --y{
    syntax:"<percentage>";
    inherits:false;
    initial-value:30%;
}

@property --x2{
    syntax:"<percentage>";
    inherits:false;
    initial-value:80%;
}

@property --y2{
    syntax:"<percentage>";
    inherits:false;
    initial-value:70%;
}

*{
    box-sizing:border-box;
}

.describe-box{
    display:flex;
    justify-content:center;
    margin:42px 15px;
}

.describe-box textarea{
    width:92vw;
    max-width:760px;
    min-height:130px;

    padding:22px 24px;

    border:2px solid transparent;
    border-radius:30px;

    outline:none;
    resize:none;

    color:#111827;
    font-size:15px;
    line-height:1.7;
    font-weight:200;

    background:
        radial-gradient(
            circle at var(--x) var(--y),
            rgba(66,133,244,.18),
            transparent 22%
        ),

        radial-gradient(
            circle at var(--x2) var(--y2),
            rgba(52,168,83,.14),
            transparent 24%
        ),

        radial-gradient(
            circle at 80% 18%,
            rgba(251,188,5,.12),
            transparent 18%
        ),

        radial-gradient(
            circle at 20% 85%,
            rgba(234,67,53,.10),
            transparent 20%
        ),

        linear-gradient(
            rgba(255,255,255,.92),
            rgba(255,255,255,.88)
        ) padding-box,

        conic-gradient(
            from var(--angle),
            #4285f4,
            #64a3ff,
            #34a853,
            #72db78,
            #fbbc05,
            #ffe08a,
            #ea4335,
            #ff8d86,
            #4285f4
        ) border-box;

    background-origin:border-box;

    background-clip:
        border-box,
        border-box,
        border-box,
        border-box,
        padding-box,
        border-box;

    backdrop-filter:blur(24px) saturate(170%);
    -webkit-backdrop-filter:blur(24px) saturate(170%);

    box-shadow:
        0 30px 80px rgba(15,23,42,.10),
        0 15px 35px rgba(15,23,42,.06),
        inset 0 1px 0 rgba(255,255,255,.95),
        inset 0 -1px 0 rgba(255,255,255,.40),
        0 0 0 1px rgba(255,255,255,.65);

    transition:
        transform .45s cubic-bezier(.22,1,.36,1),
        box-shadow .45s cubic-bezier(.22,1,.36,1),
        background .45s ease;

    animation:
        rotateBorder 4s linear infinite,
        liquidMove 18s ease-in-out infinite,
        breathingGlow 6s ease-in-out infinite;
}

.describe-box textarea::placeholder{
    color:rgba(55,65,81,.55);

    font-family:
        "Satoshi",
        "Manrope",
        "Inter",
        "SF Pro Display",
        "Segoe UI",
        sans-serif;

    font-size:17px;
    font-weight:300;
    letter-spacing:.2px;
}

.describe-box textarea:hover{
    transform:translateY(-3px);

    box-shadow:
        0 40px 90px rgba(66,133,244,.12),
        0 18px 40px rgba(15,23,42,.08),
        inset 0 1px 0 rgba(255,255,255,.95),
        0 0 40px rgba(66,133,244,.08);
}

.describe-box textarea:focus{
    transform:
        translateY(-2px)
        scale(1.005);

    background:
        radial-gradient(
            circle at var(--x) var(--y),
            rgba(66,133,244,.18),
            transparent 24%
        ),

        radial-gradient(
            circle at var(--x2) var(--y2),
            rgba(52,168,83,.14),
            transparent 25%
        ),

        radial-gradient(
            circle at 80% 18%,
            rgba(251,188,5,.12),
            transparent 18%
        ),

        radial-gradient(
            circle at 20% 85%,
            rgba(234,67,53,.10),
            transparent 20%
        ),

        linear-gradient(
            rgba(255,255,255,.95),
            rgba(255,255,255,.92)
        ) padding-box,

        conic-gradient(
            from var(--angle),
            #4285f4,
            #6faeff,
            #34a853,
            #7fe184,
            #fbbc05,
            #ffe27c,
            #ea4335,
            #ff9a90,
            #4285f4
        ) border-box;

    background-origin:border-box;

    background-clip:
        border-box,
        border-box,
        border-box,
        border-box,
        padding-box,
        border-box;

    box-shadow:
        0 20px 50px rgba(15,23,42,.08),
        0 10px 25px rgba(15,23,42,.05),
        0 0 0 3px rgba(66,133,244,.06),
        0 0 20px rgba(66,133,244,.08),
        inset 0 1px 0 rgba(255,255,255,.95);

    animation:
        rotateBorder 4s linear infinite,
        liquidMove 14s ease-in-out infinite,
        breathingGlow 5s ease-in-out infinite;
}

@keyframes rotateBorder{
    from{
        --angle:0deg;
    }
    to{
        --angle:360deg;
    }
}

@keyframes breathingGlow{
    50%{
        filter:
            brightness(1.08)
            saturate(1.15);
    }
}

@keyframes liquidMove{

    0%,100%{
        --x:18%;
        --y:25%;

        --x2:82%;
        --y2:70%;
    }

    25%{
        --x:75%;
        --y:18%;

        --x2:28%;
        --y2:80%;
    }

    50%{
        --x:88%;
        --y:70%;

        --x2:18%;
        --y2:30%;
    }

    75%{
        --x:35%;
        --y:88%;

        --x2:82%;
        --y2:22%;
    }
}

